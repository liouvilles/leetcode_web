  "summary": "判断正整数 n 是否恰好有三个正除数。",
  "insight": "恰有三个除数的数必且仅为某个质数的平方，其除数为一、质数和自身。因此检查 n 是否为完全平方且平方根为质数。",
  "pitfalls": [
    "一不是质数",
    "完全平方根还必须是质数",
    "n 较小时直接试除即可"
  ],
  "solutions": [
    {
      "id": "prime-square-characterization",
      "title": "质数平方判定",
      "kind": "最优",
      "idea": "利用三除数数的充要结构。",
      "steps": [
        "root=floor(sqrt(n))，若 root²!=n 返回 false",
        "若 root<2 返回 false",
        "试除 2..sqrt(root)，有因子返回 false，否则 true"
      ],
      "complexity": {
        "time": "O(n^1/4)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/prime-square-characterization/Solution.java",
        "kotlin": "solutions/prime-square-characterization/Solution.kt",
        "cpp": "solutions/prime-square-characterization/solution.cpp"
      }
    }
  ]
}
