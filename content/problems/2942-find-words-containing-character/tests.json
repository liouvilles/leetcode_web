{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findWordsContaining",
  "parameterTypes": [
    "stringArray",
    "char"
  ],
  "returnType": "intList",
  "cases": [
    {
      "name": "两个单词都包含字符 e",
      "args": [
        [
          "leet",
          "code"
        ],
        "e"
      ],
      "expected": [
        0,
        1
      ]
    },
    {
      "name": "重复出现字符的单词只记录一次",
      "args": [
        [
          "abc",
          "bcd",
          "aaaa",
          "cbc"
        ],
        "a"
      ],
      "expected": [
        0,
        2
      ]
    },
    {
      "name": "没有单词包含字符 z",
      "args": [
        [
          "abc",
          "bcd",
          "aaaa",
          "cbc"
        ],
        "z"
      ],
      "expected": []
    },
    {
      "name": "只有末尾单词包含目标字符",
      "args": [
        [
          "hello",
          "world",
          "sky"
        ],
        "y"
      ],
      "expected": [
        2
      ]
    }
  ]
}
