  "solutions": [
    {
      "id": "hat-by-hat-bitmask-dp",
      "title": "逐帽状态压缩动态规划",
      "kind": "最优",
      "idea": "以已分配帽子的人集合为状态推进四十顶帽子。",
      "steps": [
        "构建 hatToPeople[1..40]",
        "dp[0]=1；对每顶帽子复制 dp 表示跳过",
        "对每个 mask 和喜欢该帽子的未分配 person，next[mask|1<<person]+=dp[mask]",
        "返回 dp[(1<<people)-1]"
      ],
      "complexity": {
        "time": "O(40·2^p·p)",
        "space": "O(2^p)"
      },
