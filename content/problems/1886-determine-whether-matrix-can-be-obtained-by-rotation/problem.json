    {
      "id": "four-rotation-simulation",
      "title": "枚举四种朝向",
      "kind": "最优",
      "idea": "比较当前矩阵并连续旋转九十度。",
      "steps": [
        "repeat 四次",
        "若当前矩阵逐行相等则返回 true",
        "令 rotated[col][n-1-row]=current[row][col]，继续；结束返回 false"
      ],
      "complexity": {
        "time": "O(n²)",
