  "solutions": [
    {
      "id": "base-26-accumulation",
      "title": "从高位到低位累积",
      "kind": "最优",
      "idea": "像解析普通进制整数一样逐字符更新结果。",
      "steps": [
        "answer 初始化为零",
        "对每个字符执行 answer*=26",
        "加上 character-A+1"
