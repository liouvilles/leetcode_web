  "slug": "minimum-operations-to-make-the-array-increasing",
  "title": "最少操作使数组递增",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-026",
  "studyTags": [
    "数组",
    "贪心"
  ],
  "summary": "每次可把任一元素加一，求使数组严格递增的最少操作次数。",
  "insight": "从左到右，当前值若不大于前一调整后值，最优恰好把它增加到 previous+1；增加更多只会提高后续成本。",
  "pitfalls": [
    "比较调整后的前一值",
    "只能增加不能减少",
    "原数组可直接原地更新"
  ],
  "solutions": [
    {
      "id": "raise-to-previous-plus-one",
      "title": "提升到前值加一",
      "kind": "最优",
      "idea": "对每个违规位置执行最小必要增加。",
      "steps": [
        "operations=0",
        "i 从一：target=nums[i-1]+1",
        "若 nums[i]<target，operations+=target-nums[i] 并令 nums[i]=target，返回"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/raise-to-previous-plus-one/Solution.java",
        "kotlin": "solutions/raise-to-previous-plus-one/Solution.kt",
        "cpp": "solutions/raise-to-previous-plus-one/solution.cpp"
      }
    }
  ]
}
