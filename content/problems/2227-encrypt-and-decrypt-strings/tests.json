          "a",
          "b"
        ],
        [
          "aa",
          "bb"
        ],
        [
          "ab",
          "ba",
          "aa"
        ]
      ],
      "calls": [
        {
          "method": "encrypt",
          "parameterTypes": [
            "string"
          ],
          "args": [
            "ba"
          ],
          "returnType": "string",
          "expected": "bbaa"
        },
        {
          "method": "decrypt",
          "parameterTypes": [
            "string"
          ],
          "args": [
            "aabb"
          ],
