          "a",
          "b",
          "c",
          "d"
        ],
        [
          "ei",
          "zf",
          "ei",
          "am"
        ],
        [
          "abcd",
          "acbd",
          "adbc",
          "badc",
          "dacb",
          "cadb",
          "cbda",
          "abad"
        ]
      ],
      "calls": [
        {
          "method": "encrypt",
          "parameterTypes": [
            "string"
          ],
          "args": [
            "abcd"
          ],
          "returnType": "string",
          "expected": "eizfeiam"
        },
        {
          "method": "decrypt",
          "parameterTypes": [
            "string"
          ],
          "args": [
            "eizfeiam"
          ],
          "returnType": "int",
          "expected": 2
        }
      ]
    },
    {
