    {
      "id": "minute-difference-greedy",
      "title": "分钟差额面额贪心",
      "kind": "最优",
      "idea": "用最大允许增量优先消除差值。",
      "steps": [
        "解析 current、correct 为分钟",
        "difference=target-start",
        "依次对 60、15、5、1：answer+=difference/step，difference%=step"
      ],
      "complexity": {
        "time": "O(1)",
        "space": "O(1)"
