  "schemaVersion": 1,
  "id": 1663,
  "slug": "smallest-string-with-a-given-numeric-value",
  "title": "具有给定数值的最小字符串",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-024",
  "studyTags": [
    "字符串",
    "贪心"
  ],
  "summary": "长度 n 的小写字符串数值为各字母位置值之和，构造数值为 k 的字典序最小字符串。",
  "insight": "先把所有位置设为最小的 a，剩余 k-n 点数应尽量加到右侧；从末尾每次最多增加 25，能让前缀保持最小。",
  "pitfalls": [
    "字母值从 a=1 到 z=26",
    "必须固定长度 n",
    "从右向左分配额外数值"
  ],
  "solutions": [
    {
      "id": "right-to-left-greedy",
      "title": "从右向左填充贪心",
      "kind": "最优",
      "idea": "把较大字母推到尽可能靠后的位置。",
      "steps": [
        "chars 全部填 a，remaining=k-n",
        "index 从 n-1 向前，add=min(25,remaining)",
        "chars[index]+=add，扣减 remaining，返回字符串"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/right-to-left-greedy/Solution.java",
        "kotlin": "solutions/right-to-left-greedy/Solution.kt",
        "cpp": "solutions/right-to-left-greedy/solution.cpp"
      }
    }
  ]
}
