  "studyTags": [
    "数组",
    "贪心",
    "模拟"
  ],
  "summary": "花坛中相邻位置不能同时种花，判断能否在现有布局中再种下 n 朵花。",
  "insight": "从左到右遇到左右均为空的位置就立即种花，这个最早选择不会减少后续可用位置。",
  "pitfalls": [
    "边界外可视为空位",
    "原有花朵之间保证不相邻",
    "n 为零时必然可行"
  ],
  "solutions": [
    {
      "id": "left-to-right-greedy",
      "title": "从左到右贪心种植",
      "kind": "最优",
      "idea": "在每个当前合法空位种花并减少剩余需求。",
      "steps": [
        "若 n=0 直接成功",
        "扫描空位并检查左邻与右邻",
        "合法时写入 1，n--；降到零即返回真，结束返回假"
      ],
      "complexity": {
        "time": "O(length)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/left-to-right-greedy/Solution.java",
        "kotlin": "solutions/left-to-right-greedy/Solution.kt",
        "cpp": "solutions/left-to-right-greedy/solution.cpp"
      }
    }
  ]
}
