    {
      "id": "track-two-smallest-prices",
      "title": "维护最小与次小价格",
      "kind": "最优",
      "idea": "一次扫描找出两块最便宜巧克力。",
      "steps": [
        "first=second=无穷",
        "遍历 price",
        "若 price<first，second=first、first=price；否则若 price<second，second=price",
        "cost=first+second",
        "cost<=money 返回 money-cost，否则 money"
      ],
