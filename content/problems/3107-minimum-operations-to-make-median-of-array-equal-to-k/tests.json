{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minOperationsToMakeMedianK",
  "parameterTypes": [
    "intArray",
    "int"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "两个五各下降一使中位数变四",
      "args": [
        [
          2,
          5,
          6,
          8,
          5
        ],
        4
      ],
      "expected": 2
    },
    {
      "name": "五和六共上升三使中位数变七",
      "args": [
        [
          2,
          5,
          6,
          8,
          5
        ],
        7
      ],
      "expected": 3
    },
    {
      "name": "偶数长度采用较大中位数并下降一",
      "args": [
        [
          1,
          2,
          3,
          4
        ],
        2
      ],
      "expected": 1
    },
    {
      "name": "单元素已等于目标无需操作",
      "args": [
        [
          1
        ],
        1
      ],
      "expected": 0
    },
    {
      "name": "五个十亿元素需修改三个值到一",
      "args": [
        [
          1000000000,
          1000000000,
          1000000000,
          1000000000,
          1000000000
        ],
        1
      ],
      "expected": 2999999997
    },
    {
      "name": "目标已是当前中位数时答案为零",
      "args": [
        [
          7,
          1,
          5,
          3,
          9
        ],
        5
      ],
      "expected": 0
    }
  ]
}
