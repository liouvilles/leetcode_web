  "solutions": [
    {
      "id": "outer-letter-first-last",
      "title": "枚举首尾字母区间",
      "kind": "最优",
      "idea": "为每种外层字母统计其首末位置间不同中间字符数。",
      "steps": [
        "求 26 个字母 first 与 last",
        "对 letter 若 first+1<last，建立中间字符集合",
        "把集合大小累加返回"
      ],
      "complexity": {
        "time": "O(26n)",
        "space": "O(26)"
      },
