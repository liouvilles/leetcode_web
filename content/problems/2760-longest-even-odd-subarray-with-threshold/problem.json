  "title": "最长奇偶子数组",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-045",
  "studyTags": [
    "数组",
    "滑动窗口"
  ],
  "summary": "求最长连续子数组，要求首元素为偶数、相邻元素奇偶交替且所有元素不超过 threshold。",
  "insight": "从左到右维护当前合法后缀长度。超阈值时清零；没有合法后缀时只有当前偶数能开启长度一；已有后缀时奇偶不同就延长，否则当前偶数可重新开始。",
  "pitfalls": [
    "子数组必须从偶数开始",
    "每个元素都不能超过阈值",
    "奇偶相同会终止当前窗口",
    "奇数不能单独作为新窗口起点"
  ],
  "solutions": [
    {
      "id": "scan-valid-alternating-suffix",
      "title": "扫描合法交替后缀",
      "kind": "最优",
      "idea": "维护以当前位置结尾的最长合法长度。",
      "steps": [
        "current=0、answer=0",
        "若 nums[i]>threshold，current=0",
        "否则 current 为零时，偶数开启长度一",
        "current 非零且与前一项奇偶不同则加一",
        "奇偶相同时仅当前为偶数才重置为一",
        "更新 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/scan-valid-alternating-suffix/Solution.java",
        "kotlin": "solutions/scan-valid-alternating-suffix/Solution.kt",
        "cpp": "solutions/scan-valid-alternating-suffix/solution.cpp"
      }
    }
  ]
}
