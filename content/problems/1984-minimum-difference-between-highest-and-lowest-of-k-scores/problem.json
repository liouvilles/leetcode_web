      "id": "sorted-k-window",
      "title": "排序长度 K 窗口",
      "kind": "最优",
      "idea": "枚举排序后每组连续 k 个分数。",
      "steps": [
        "排序 nums",
        "answer=∞",
        "right 从 k-1 到 n-1，更新 nums[right]-nums[right-k+1]，返回"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(log n)"
