{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findLeastNumOfUniqueInts",
  "parameterTypes": [
    "intArray",
    "int"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "删掉单个四只剩一种",
      "args": [
        [
          5,
          5,
          4
        ],
        1
      ],
      "expected": 1
    },
    {
      "name": "删除三项后剩两种",
      "args": [
        [
          4,
          3,
          1,
          1,
          3,
          3,
          2
        ],
        3
      ],
      "expected": 2
    },
    {
      "name": "不删除保留三种",
      "args": [
        [
          1,
          2,
          3
        ],
        0
      ],
      "expected": 3
    }
  ]
}
