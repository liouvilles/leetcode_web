  "cases": [
    {
      "name": "至少四个数共同达到的位组成九",
      "args": [
        [
          7,
          12,
          9,
          8,
          9,
          15
        ],
        4
      ],
      "expected": 9
    },
    {
      "name": "三个数中每一低位都出现两次",
      "args": [
        [
          3,
          5,
          6
        ],
        2
      ],
      "expected": 7
    },
    {
      "name": "互不相同的单置位均未达到两次",
      "args": [
        [
          1,
          2,
          4
        ],
        2
      ],
      "expected": 0
    },
    {
      "name": "k 为一时等价于全数组按位或",
      "args": [
        [
          10,
          8,
          5,
          9,
          11,
          6,
          8
        ],
        1
      ],
      "expected": 15
    },
    {
      "name": "最高合法位可被计入答案",
      "args": [
        [
          1073741824,
          1073741824
        ],
        2
      ],
      "expected": 1073741824
