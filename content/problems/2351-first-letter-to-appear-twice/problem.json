  "solutions": [
    {
      "id": "seen-letter-bitmask",
      "title": "已见字母位掩码",
      "kind": "最优",
      "idea": "常数空间检测首次重复。",
      "steps": [
        "mask=0",
        "对 ch 计算 bit=1<<(ch-a)",
        "若 mask&bit 非零返回 ch",
        "否则 mask|=bit"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
