  "summary": "数组只含零一二，统计形如若干零、若干一、若干二且每段均非空的子序列数量并取模。",
  "insight": "维护 zero、one、two 三种已完成阶段的方案数。遇零时已有纯零序列可选或不选并可新建；遇一、二时同理扩展当前阶段或从前一阶段转入。",
  "pitfalls": [
    "三段都必须非空",
    "子序列保持下标顺序",
    "每个同值元素可选或不选"
  ],
  "solutions": [
    {
      "id": "three-phase-subsequence-dp",
      "title": "零一二三阶段 DP",
      "kind": "最优",
      "idea": "按元素值更新对应阶段的方案数。",
      "steps": [
        "zero=one=two=0",
        "value=0：zero=2*zero+1；value=1：one=2*one+zero",
        "value=2：two=2*two+one；均取模，返回 two"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/three-phase-subsequence-dp/Solution.java",
        "kotlin": "solutions/three-phase-subsequence-dp/Solution.kt",
        "cpp": "solutions/three-phase-subsequence-dp/solution.cpp"
      }
    }
  ]
}
