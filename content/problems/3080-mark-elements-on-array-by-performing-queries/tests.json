{
  "schemaVersion": 1,
  "mode": "function",
  "method": "unmarkedSumArray",
  "parameterTypes": [
    "intArray",
    "intMatrix"
  ],
  "returnType": "longArray",
  "cases": [
    {
      "name": "官方示例依次剩余八三和零",
      "args": [
        [
          1,
          2,
          2,
          1,
          2,
          3,
          1
        ],
        [
          [
            1,
            2
          ],
          [
            3,
            3
          ],
          [
            4,
            2
          ]
        ]
      ],
      "expected": [
        8,
        3,
        0
      ]
    },
    {
      "name": "指定下标后再标记当前最小元素",
      "args": [
        [
          1,
          4,
          2,
          3
        ],
        [
          [
            0,
            1
          ]
        ]
      ],
      "expected": [
        7
      ]
    },
    {
      "name": "相同最小值按下标顺序选择且最终全部标记",
      "args": [
        [
          5,
          1,
          1,
          5
        ],
        [
          [
            3,
            1
          ],
          [
            0,
            2
          ]
        ]
      ],
      "expected": [
        6,
        0
      ]
    },
    {
      "name": "零个额外元素与重复指定下标均正确处理",
      "args": [
        [
          3,
          2,
          1
        ],
        [
          [
            1,
            0
          ],
          [
            1,
            1
          ]
        ]
      ],
      "expected": [
        4,
        3
      ]
    },
    {
      "name": "额外标记数覆盖全部剩余元素",
      "args": [
        [
          4,
          2,
          7
        ],
        [
          [
            2,
            2
          ]
        ]
      ],
      "expected": [
        0
      ]
    }
  ]
}
