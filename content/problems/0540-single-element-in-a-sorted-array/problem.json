  "studyTags": [
    "二分查找",
    "奇偶下标",
    "有序数组"
  ],
  "summary": "有序数组中除一个元素只出现一次外其余都恰好出现两次，在对数时间内找出单一元素。",
  "insight": "单一元素之前的配对从偶数下标开始，之后配对从奇数下标开始；把中点调整为偶数即可判断单一元素在哪侧。",
  "pitfalls": [
    "数组长度为奇数",
    "middle 需调整到偶数下标",
    "比较 nums[middle] 与 nums[middle+1]"
  ],
  "solutions": [
    {
      "id": "pair-parity-binary-search",
      "title": "配对起点奇偶二分",
      "kind": "最优",
      "idea": "利用单一元素造成的配对下标错位收缩搜索区间。",
      "steps": [
        "left=0,right=n-1",
        "middle 取中点并若为奇数则减一",
        "若 middle 与 middle+1 相等则 left=middle+2，否则 right=middle，返回 nums[left]"
      ],
      "complexity": {
        "time": "O(log n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/pair-parity-binary-search/Solution.java",
        "kotlin": "solutions/pair-parity-binary-search/Solution.kt",
        "cpp": "solutions/pair-parity-binary-search/solution.cpp"
      }
    }
  ]
}
