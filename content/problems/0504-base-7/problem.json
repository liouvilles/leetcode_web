  "solutions": [
    {
      "id": "repeated-division",
      "title": "反复除七取余",
      "kind": "最优",
      "idea": "标准进制转换并处理符号。",
      "steps": [
        "num==0 返回 0",
        "value=abs(num)，循环追加 value%7 并 value/=7",
        "若原数为负追加负号，再整体反转"
      ],
      "complexity": {
        "time": "O(log7 |n|)",
        "space": "O(log7 |n|)"
      },
