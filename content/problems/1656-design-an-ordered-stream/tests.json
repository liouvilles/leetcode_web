        {
          "method": "insert",
          "parameterTypes": [
            "int",
            "string"
          ],
          "args": [
            3,
            "c"
          ],
          "returnType": "stringList",
          "expected": []
        },
        {
          "method": "insert",
          "parameterTypes": [
            "int",
            "string"
          ],
          "args": [
            1,
            "a"
          ],
          "returnType": "stringList",
          "expected": [
            "a",
            "b",
            "c"
          ]
        }
      ]
