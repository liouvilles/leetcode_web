  "summary": "座位数组中一表示有人、零表示空位，选择空位使到最近人的距离最大，返回该距离。",
  "insight": "两名已坐者之间最长零段的最佳距离是间距的一半；首尾零段只受单侧约束，距离等于整段长度。",
  "pitfalls": [
    "至少有一个有人座位",
    "中间段使用整数除二",
    "首段和尾段需单独按单侧距离计算"
  ],
  "solutions": [
    {
      "id": "occupied-seat-gap-scan",
      "title": "扫描已占座位间距",
      "kind": "最优",
      "idea": "比较首尾空段和相邻有人座位的中点距离。",
      "steps": [
        "previous=-1，扫描每个值一的位置 i",
        "若是第一个有人位置，answer=max(answer,i)，否则 answer=max(answer,(i-previous)/2)",
        "更新 previous；扫描后 answer=max(answer,n-1-previous)"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/occupied-seat-gap-scan/Solution.java",
