{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maximumSubarraySum",
  "parameterTypes": [
    "intArray",
    "int"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "相邻五六组成最大好子数组和十一",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        1
      ],
      "expected": 11
    },
    {
      "name": "二到五的长子数组首尾差三且和十一",
      "args": [
        [
          -1,
          3,
          2,
          4,
          5
        ],
        3
      ],
      "expected": 11
    },
    {
      "name": "所有合法子数组为负时返回负六",
      "args": [
        [
          -1,
          -2,
          -3,
          -4
        ],
        2
      ],
      "expected": -6
    },
    {
      "name": "没有首尾差五的子数组时返回零",
      "args": [
        [
          1,
          2,
          3
        ],
        5
      ],
      "expected": 0
    },
    {
      "name": "三个十亿级元素的答案超过整数范围",
      "args": [
        [
          1000000000,
          1000000000,
          999999999
        ],
        1
      ],
      "expected": 2999999999
    }
  ]
}
