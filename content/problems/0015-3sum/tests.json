      ]
    },
    {
      "name": "不存在零和三元组",
      "args": [
        [
          0,
          1,
          1
        ]
      ],
      "expected": []
    },
    {
      "name": "多个零只保留一个组合",
      "args": [
        [
          0,
          0,
          0
        ]
      ],
      "expected": [
        [
          0,
          0,
          0
        ]
      ]
    }
  ]
