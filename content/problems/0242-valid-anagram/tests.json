{
  "schemaVersion": 1,
  "mode": "function",
  "method": "isAnagram",
  "parameterTypes": [
    "string",
    "string"
  ],
  "returnType": "boolean",
  "cases": [
    {
      "name": "字符重排后相同",
      "args": [
