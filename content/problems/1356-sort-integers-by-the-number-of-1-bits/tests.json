        8,
        3,
        5,
        6,
        7
      ]
    },
    {
      "name": "全为二的幂按值排序",
      "args": [
        [
          1024,
          512,
          256,
          128,
          64,
          32,
          16,
          8,
          4,
          2,
          1
        ]
      ],
      "expected": [
        1,
        2,
        4,
        8,
        16,
        32,
        64,
        128,
        256,
        512,
        1024
      ]
    },
    {
      "name": "重复数字保留",
      "args": [
        [
