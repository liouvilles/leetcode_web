{
  "schemaVersion": 1,
  "mode": "function",
  "method": "hasTrailingZeros",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "boolean",
  "cases": [
    {
      "name": "二与四按位或最低位为零",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "expected": true
    },
    {
      "name": "四个偶数可任选两个",
      "args": [
        [
          2,
          4,
          8,
          16
        ]
      ],
      "expected": true
    },
    {
      "name": "全是奇数时任何选择最低位都为一",
      "args": [
        [
          1,
          3,
          5,
          7,
          9
        ]
      ],
      "expected": false
    },
    {
      "name": "只有一个偶数不满足至少选择两个",
      "args": [
        [
          1,
          2
        ]
      ],
      "expected": false
    },
    {
      "name": "两个偶数不必相邻",
      "args": [
        [
          100,
          99,
          97,
          98
        ]
      ],
      "expected": true
    }
  ]
}
