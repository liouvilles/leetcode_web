  "summary": "判断能否从正整数数组中选择至少两个元素，使它们按位或的二进制表示至少有一个尾随零。",
  "insight": "按位或结果有尾随零等价于最低位为零；或运算的最低位只有在所有被选数字最低位都为零时才为零。因此存在合法选择当且仅当数组中至少有两个偶数。",
  "pitfalls": [
    "必须选择至少两个元素，只有一个偶数仍不满足",
    "尾随零只需至少一个，因此只需检查最低位",
    "任意奇数参与按位或都会把结果最低位置一",
    "不需要真的枚举子集或计算所有按位或结果"
  ],
  "solutions": [
    {
      "id": "count-two-even-values",
      "title": "统计至少两个偶数",
      "kind": "最优",
      "idea": "扫描数组并在遇到第二个最低位为零的数时返回真。",
      "steps": [
        "even=0",
        "遍历 nums",
        "若 (value&1)==0，则 even++",
        "even 达到二时立即返回 true",
        "扫描结束返回 false"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/count-two-even-values/Solution.java",
        "kotlin": "solutions/count-two-even-values/Solution.kt",
        "cpp": "solutions/count-two-even-values/solution.cpp"
      }
    }
  ]
