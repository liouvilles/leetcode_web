  "slug": "peak-index-in-a-mountain-array",
  "title": "山脉数组的峰顶索引",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-011",
  "studyTags": [
    "数组",
    "二分查找"
  ],
  "summary": "严格先增后减的山脉数组中，返回唯一峰顶的下标。",
  "insight": "比较 arr[mid] 与 arr[mid+1]：仍在上坡则峰顶在右侧，否则峰顶在 mid 或左侧，二分收敛到峰顶。",
  "pitfalls": [
    "high 初始化最后下标",
    "访问 mid+1 在 low<high 时安全",
    "下坡时 high=mid 而非 mid-1，mid 可能就是峰顶"
  ],
  "solutions": [
    {
      "id": "slope-binary-search",
      "title": "坡度二分查找",
      "kind": "最优",
      "idea": "根据中点右侧坡向保留含峰区间。",
      "steps": [
        "low=0,high=n-1",
        "while low<high，middle=(low+high)/2",
        "若 arr[middle]<arr[middle+1]，low=middle+1；否则 high=middle，结束返回 low"
      ],
      "complexity": {
        "time": "O(log n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/slope-binary-search/Solution.java",
        "kotlin": "solutions/slope-binary-search/Solution.kt",
        "cpp": "solutions/slope-binary-search/solution.cpp"
      }
    }
  ]
}
