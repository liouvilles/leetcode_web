{
  "schemaVersion": 1,
  "mode": "function",
  "method": "returnToBoundaryCount",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "二三负五在第三步首次回到边界",
      "args": [
        [
          2,
          3,
          -5
        ]
      ],
      "expected": 1
    },
    {
      "name": "移动过程从未回到零",
      "args": [
        [
          3,
          2,
          -3,
          -4
        ]
      ],
      "expected": 0
    },
    {
      "name": "一负一交替两次回到边界",
      "args": [
        [
          1,
          -1,
          1,
          -1
        ]
      ],
      "expected": 2
    },
    {
      "name": "负一与一恰好抵消一次",
      "args": [
        [
          -1,
          1
        ]
      ],
      "expected": 1
    },
    {
      "name": "第三步和第五步分别回到边界",
      "args": [
        [
          5,
          -2,
          -3,
          4,
          -4
        ]
      ],
      "expected": 2
    }
  ]
}
