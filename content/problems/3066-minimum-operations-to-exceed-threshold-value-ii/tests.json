{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minOperations",
  "parameterTypes": [
    "intArray",
    "int"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "两次合并使最小值达到十",
      "args": [
        [
          2,
          11,
          10,
          1,
          3
        ],
        10
      ],
      "expected": 2
    },
    {
      "name": "连续四次合并后唯一元素超过二十",
      "args": [
        [
          1,
          1,
          2,
          4,
          9
        ],
        20
      ],
      "expected": 4
    },
    {
      "name": "堆顶已达到阈值无需操作",
      "args": [
        [
          10,
          11
        ],
        10
      ],
      "expected": 0
    },
    {
      "name": "中间合成值超过整数范围仍正确",
      "args": [
        [
          600000000,
          600000000,
          700000000,
          1000000000
        ],
        1000000000
      ],
      "expected": 2
    },
    {
      "name": "四个一合并为两个三再合并成九",
      "args": [
        [
          1,
          1,
          1,
          1
        ],
        9
      ],
      "expected": 3
    }
  ]
}
