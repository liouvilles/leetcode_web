  "summary": "相同任务两次执行之间至少间隔 n 个时间单位，求完成全部任务所需的最短时间。",
  "insight": "由最高频任务搭出若干长度 n+1 的框架，最后一组只需放最高频任务；若其他任务足够填满空位，则总任务数成为下界。",
  "pitfalls": [
    "有多个最高频任务时最后一组都要计入",
    "冷却时间为零时答案就是任务数",
    "最终答案不能小于任务总数"
  ],
  "solutions": [
    {
      "id": "frequency-frame",
      "title": "最高频任务构造时间框架",
      "kind": "最优",
      "idea": "用最高频次数和并列最高频任务数直接计算框架长度。",
      "steps": [
        "统计 26 类任务频次",
        "找 maximumFrequency 与达到该频次的类型数",
        "返回 max(tasks.length,(maximum-1)*(n+1)+maximumKinds)"
      ],
      "complexity": {
        "time": "O(tasks)",
        "space": "O(1)"
      },
