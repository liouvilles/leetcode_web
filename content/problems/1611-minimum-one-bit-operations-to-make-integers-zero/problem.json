  "summary": "按题目规定只能翻转最低位，或在低位满足特定形态时翻转高一位，求把 n 变为零的最少操作。",
  "insight": "允许操作序列对应二进制反射格雷码；从格雷码 n 恢复其二进制序号即最少步数，逆变换为不断把 n 的右移版本异或到答案。",
  "pitfalls": [
    "零的答案为零",
    "异或累积包括原 n",
    "使用无符号右移对非负整数等价普通右移"
  ],
  "solutions": [
    {
      "id": "inverse-gray-code",
      "title": "格雷码逆变换",
      "kind": "最优",
      "idea": "把状态编码还原为从零开始的格雷序列下标。",
      "steps": [
        "answer=0",
        "while n>0",
        "answer xor=n，n>>=1；返回 answer"
      ],
      "complexity": {
        "time": "O(log n)",
        "space": "O(1)"
      },
