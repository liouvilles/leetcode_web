          3,
          5,
          7
        ],
        2
      ],
      "expected": 4
    },
    {
      "name": "选择跳过元素",
      "args": [
        [
          1,
          5,
          7,
          8,
          5,
          3,
          4,
          2,
          1
        ],
        -2
      ],
      "expected": 4
    }
