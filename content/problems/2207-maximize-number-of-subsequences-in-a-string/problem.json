  "summary": "向 text 任意位置插入 pattern 的一个字符，最大化等于长度二 pattern 的子序列数量。",
  "insight": "先统计原有 pattern 子序列。若插入 pattern[0] 到最前面，可与所有 pattern[1] 配对；若插入 pattern[1] 到最后面，可与所有 pattern[0] 配对，取两者较大。",
  "pitfalls": [
    "只插入一个字符",
    "pattern 两字符可相同",
    "计数使用 long"
  ],
  "solutions": [
    {
      "id": "count-existing-plus-best-end-insertion",
      "title": "已有子序列加最佳端点插入",
      "kind": "最优",
      "idea": "最优插入位置可推到最前或最后。",
      "steps": [
        "扫描 text，遇 pattern[1] 时 existing+=seenFirst，遇 pattern[0] 时 seenFirst++",
        "同时统计 firstCount、secondCount",
        "返回 existing+max(firstCount,secondCount)"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
