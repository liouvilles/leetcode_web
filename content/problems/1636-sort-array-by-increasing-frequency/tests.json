{
  "schemaVersion": 1,
  "mode": "function",
  "method": "frequencySort",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "intArray",
  "cases": [
    {
      "name": "按频率一二三排序",
      "args": [
        [
          1,
          1,
          2,
          2,
          2,
          3
        ]
      ],
      "expected": [
        3,
        1,
        1,
        2,
        2,
        2
      ]
    },
    {
      "name": "同频率时较大值在前",
      "args": [
        [
          2,
          3,
          1,
          3,
          2
        ]
      ],
      "expected": [
        1,
        3,
        3,
        2,
        2
      ]
    },
    {
      "name": "包含负数的多级频率",
      "args": [
        [
          -1,
          1,
          -6,
          4,
          5,
          -6,
          1,
          4,
          1
        ]
      ],
      "expected": [
        5,
        -1,
        4,
        4,
        -6,
        -6,
        1,
        1,
        1
      ]
    }
  ]
}
