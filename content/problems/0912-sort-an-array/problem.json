      "id": "top-down-merge-sort",
      "title": "自顶向下归并排序",
      "kind": "最优",
      "idea": "分治排序左右半区并归并。",
      "steps": [
        "创建 temporary 数组",
        "sort(left,right)：left>=right 返回，递归两半",
        "merge 用双指针把较小值写 temporary，再复制回 nums[left..right]，最终返回 nums"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(n)"
      },
