      "steps": [
        "degree[n] 与 connected[n][n]",
        "扫描 roads 更新度数和邻接",
        "枚举 first<second，更新 degree[first]+degree[second]-(connected?1:0)"
      ],
      "complexity": {
        "time": "O(n²+r)",
        "space": "O(n²)"
