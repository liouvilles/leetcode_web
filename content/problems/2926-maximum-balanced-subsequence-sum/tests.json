{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maxBalancedSubsequenceSum",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "选择零二三号形成和十四的平衡序列",
      "args": [
        [
          3,
          3,
          5,
          6
        ]
      ],
      "expected": 14
    },
    {
      "name": "首尾两个正数可以相接",
      "args": [
        [
          5,
          -1,
          -3,
          8
        ]
      ],
      "expected": 13
    },
    {
      "name": "全负数必须选择最大的单个元素",
      "args": [
        [
          -2,
          -1
        ]
      ],
      "expected": -1
    },
    {
      "name": "连续递增数组可以全部选择",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": 6
    },
    {
      "name": "三个大数验证六十四位子序列和",
      "args": [
        [
          999999998,
          999999999,
          1000000000
        ]
      ],
      "expected": 2999999997
    }
  ]
}
