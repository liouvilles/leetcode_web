{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findKDistantIndices",
  "parameterTypes": [
    "intArray",
    "int",
    "int"
  ],
  "returnType": "intList",
  "cases": [
    {
      "name": "两个 key 覆盖零到六",
      "args": [
        [
          3,
          4,
          9,
          1,
          3,
          9,
          5
        ],
        9,
        1
      ],
      "expected": [
        1,
        2,
        3,
        4,
        5,
        6
      ]
    },
    {
      "name": "单个 key 覆盖全部",
      "args": [
        [
          2,
          2,
          2,
          2,
          2
        ],
        2,
        2
      ],
      "expected": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    {
      "name": "k 为零只返回 key 下标",
      "args": [
        [
          1,
          2,
          1
        ],
        1,
        0
      ],
      "expected": [
        0,
        2
      ]
    }
  ]
}
