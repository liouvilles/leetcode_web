    {
      "id": "digit-graph-dp",
      "title": "数字图滚动动态规划",
      "kind": "最优",
      "idea": "在固定骑士邻接表上逐步转移。",
      "steps": [
        "dp 十个位置初始化为一",
        "重复 n-1 轮，为每个 from 把 dp[from] 加到所有邻接 to",
        "滚动替换 dp，求和取模返回"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
