{
  "schemaVersion": 1,
  "mode": "function",
  "method": "numberOfGoodPartitions",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "四个独立值有三个可选切口",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 8
    },
    {
      "name": "两个重复值区间形成两个连通块",
      "args": [
        [
          1,
          1,
          2,
          2
        ]
      ],
      "expected": 2
    },
    {
      "name": "一的区间包住二后仍与末尾三分开",
      "args": [
        [
          1,
          2,
          1,
          3
        ]
      ],
      "expected": 2
    },
    {
      "name": "三个值的区间全部重叠只能整段",
      "args": [
        [
          1,
          2,
          3,
          1,
          2,
          3
        ]
      ],
      "expected": 1
    },
    {
      "name": "单元素数组只有一种分割",
      "args": [
        [
          7
        ]
      ],
      "expected": 1
    }
  ]
}
