{
  "schemaVersion": 1,
  "mode": "function",
  "method": "shortestPalindrome",
  "parameterTypes": [
    "string"
  ],
  "returnType": "string",
  "cases": [
    {
      "name": "已有长回文前缀",
      "args": [
        "aacecaaa"
      ],
      "expected": "aaacecaaa"
    },
    {
      "name": "只有首字符为回文前缀",
      "args": [
        "abcd"
      ],
      "expected": "dcbabcd"
    },
    {
      "name": "空串",
      "args": [
        ""
      ],
      "expected": ""
    }
  ]
}
