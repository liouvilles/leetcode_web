          "apple",
          "pen"
        ]
      ],
      "expected": true
    },
    {
      "name": "局部可拆但整体失败",
      "args": [
        "catsandog",
        [
          "cats",
          "dog",
          "sand",
          "and",
          "cat"
        ]
      ],
      "expected": false
    }
  ]
