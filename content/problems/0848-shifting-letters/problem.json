  "title": "字母移位",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-011",
  "studyTags": [
    "数组",
    "字符串",
    "前缀和"
  ],
  "summary": "第 i 个操作把字符串前 i+1 个字母都向后移 shifts[i] 次，返回全部操作后的字符串。",
  "insight": "位置 i 受到 shifts[i..n-1] 的所有操作影响；从右向左维护后缀移位和并对 26 取模即可原地计算。",
  "pitfalls": [
    "z 后移一位回到 a",
    "后缀总和可能很大，应持续取模或用长整型",
    "每个 shifts[i] 影响的是前缀而非后缀"
  ],
  "solutions": [
    {
      "id": "reverse-suffix-shift-sum",
      "title": "反向后缀移位和",
      "kind": "最优",
      "idea": "从末尾累加每个位置所受总移位。",
      "steps": [
        "字符数组 chars=s.toCharArray，shift=0",
        "i 从 n-1 到零，shift=(shift+shifts[i])%26",
        "chars[i]=(chars[i]-a+shift)%26+a，结束返回字符串"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/reverse-suffix-shift-sum/Solution.java",
        "kotlin": "solutions/reverse-suffix-shift-sum/Solution.kt",
        "cpp": "solutions/reverse-suffix-shift-sum/solution.cpp"
      }
    }
  ]
}
