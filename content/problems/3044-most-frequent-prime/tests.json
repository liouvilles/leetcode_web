{
  "schemaVersion": 1,
  "mode": "function",
  "method": "mostFrequentPrime",
  "parameterTypes": [
    "intMatrix"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "多个方向反复生成十九使其频次最高",
      "args": [
        [
          [
            1,
            1
          ],
          [
            9,
            9
          ],
          [
            1,
            1
          ]
        ]
      ],
      "expected": 19
    },
    {
      "name": "单格质数不满足大于十",
      "args": [
        [
          [
            7
          ]
        ]
      ],
      "expected": -1
    },
    {
      "name": "三阶矩阵最高频质数为九十七",
      "args": [
        [
          [
            9,
            7,
            8
          ],
          [
            4,
            6,
            5
          ],
          [
            2,
            8,
            6
          ]
        ]
      ],
      "expected": 97
    },
    {
      "name": "单行二三只生成质数二十三",
      "args": [
        [
          [
            2,
            3
          ]
        ]
      ],
      "expected": 23
    },
    {
      "name": "多个质数同频时选择最大的一三七",
      "args": [
        [
          [
            1,
            3,
            7
          ]
        ]
      ],
      "expected": 137
    },
    {
      "name": "全一矩阵只会生成质数十一",
      "args": [
        [
          [
            1,
            1
          ],
          [
            1,
            1
          ]
        ]
      ],
      "expected": 11
    }
  ]
}
