      "id": "two-distinct-maximums",
      "title": "两个不同最大值",
      "kind": "最优",
      "idea": "常数状态在线维护最大和次大数字。",
      "steps": [
        "largest=second=-1",
        "遇 digit：若 digit>largest，second=largest、largest=digit",
        "否则若 digit<largest 且 digit>second，更新 second；返回 second"
      ],
