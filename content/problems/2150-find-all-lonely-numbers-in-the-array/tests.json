{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findLonely",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "intList",
  "cases": [
    {
      "name": "十和八为孤独数字",
      "args": [
        [
          10,
          6,
          5,
          8
        ]
      ],
      "expected": [
        10,
        8
      ]
    },
    {
      "name": "重复值与相邻值均排除",
      "args": [
        [
          1,
          3,
          5,
          3
        ]
      ],
      "expected": [
        1,
        5
      ]
    },
    {
      "name": "连续数字没有孤独值",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": []
    }
  ]
}
