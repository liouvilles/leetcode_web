  "solutions": [
    {
      "id": "weighted-median",
      "title": "加权中位数",
      "kind": "最优",
      "idea": "绝对值加权和在权重中位点最小。",
      "steps": [
        "按 nums 排序下标",
        "totalWeight=sum(cost)，累计到两倍不小于 total 时取 target",
        "answer=sum(abs(nums[i]-target)*cost[i])",
        "返回 answer"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(n)"
      },
