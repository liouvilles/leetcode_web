  "solutions": [
    {
      "id": "rotate-on-push",
      "title": "入栈时旋转队列",
      "kind": "最优",
      "idea": "保持队首始终是最近压入的元素，使 pop 和 top 为常数时间。",
      "steps": [
        "新值入队尾",
        "把 size-1 个旧元素逐个出队再入队",
        "pop 取队首，top 查看队首"
      ],
      "complexity": {
        "time": "push O(n), pop O(1)",
        "space": "O(n)"
      },
