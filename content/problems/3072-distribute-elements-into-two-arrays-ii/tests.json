{
  "schemaVersion": 1,
  "mode": "function",
  "method": "resultArray",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "intArray",
  "cases": [
    {
      "name": "greaterCount 持平后按长度平衡重复值",
      "args": [
        [
          2,
          1,
          3,
          3
        ]
      ],
      "expected": [
        2,
        3,
        1,
        3
      ]
    },
    {
      "name": "较大元素计数使后续值连续进入第一数组",
      "args": [
        [
          5,
          14,
          3,
          1,
          2
        ]
      ],
      "expected": [
        5,
        3,
        1,
        2,
        14
      ]
    },
    {
      "name": "全相等元素依靠长度规则交替分配",
      "args": [
        [
          1,
          1,
          1,
          1,
          1
        ]
      ],
      "expected": [
        1,
        1,
        1,
        1,
        1
      ]
    },
    {
      "name": "全部 greaterCount 为零时按长度分流",
      "args": [
        [
          10,
          20,
          30,
          40
        ]
      ],
      "expected": [
        10,
        30,
        20,
        40
      ]
    },
    {
      "name": "动态计数与长度规则共同决定分配",
      "args": [
        [
          4,
          1,
          3,
          2,
          5
        ]
      ],
      "expected": [
        4,
        3,
        2,
        1,
        5
      ]
    },
    {
      "name": "十亿坐标与重复值完成离散化",
      "args": [
        [
          1000000000,
          1,
          5,
          5
        ]
      ],
      "expected": [
        1000000000,
        5,
        5,
        1
      ]
    }
  ]
}
