{
  "schemaVersion": 1,
  "mode": "function",
  "method": "distance",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "longArray",
  "cases": [
    {
      "name": "值一的三个位置分别计算距离和",
      "args": [
        [
          1,
          3,
          1,
          1,
          2
        ]
      ],
      "expected": [
        5,
        0,
        3,
        4,
        0
      ]
    },
    {
      "name": "全不同元素距离和均零",
      "args": [
        [
          0,
          5,
          3
        ]
      ],
      "expected": [
        0,
        0,
        0
      ]
    },
    {
      "name": "两个相同元素互距一",
      "args": [
        [
          7,
          7
        ]
      ],
      "expected": [
        1,
        1
      ]
    }
  ]
}
