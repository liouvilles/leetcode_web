  "slug": "longer-contiguous-segments-of-ones-than-zeros",
  "title": "哪种连续子字符串更长",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-027",
  "studyTags": [
    "字符串"
  ],
  "summary": "判断二进制字符串中最长连续一段是否严格长于最长连续零段。",
  "insight": "线性扫描同时维护当前零段、当前一段和各自最大值，遇到另一字符就把对应当前长度清零。",
  "pitfalls": [
    "要求严格大于",
    "不存在的字符最长段为零",
    "多个分散段分别比较最大值"
  ],
  "solutions": [
    {
      "id": "two-run-counters",
      "title": "双连续段计数器",
      "kind": "最优",
      "idea": "一次扫描记录两类字符的最长连续长度。",
      "steps": [
        "ones=zeros=bestOne=bestZero=0",
        "字符为 1 时 ones++、zeros=0，否则反之",
        "同步更新最大值，返回 bestOne>bestZero"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/two-run-counters/Solution.java",
        "kotlin": "solutions/two-run-counters/Solution.kt",
        "cpp": "solutions/two-run-counters/solution.cpp"
      }
    }
  ]
