  "slug": "minimum-moves-to-reach-target-score",
  "title": "得到目标值的最少行动次数",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-031",
  "studyTags": [
    "数学",
    "贪心"
  ],
  "summary": "从一开始，每步可加一，且至多使用指定次数的翻倍操作，求到达 target 的最少步数。",
  "insight": "逆向从 target 回到一：仍可使用翻倍且当前为偶数时，除二比连续减一更优；奇数先减一。翻倍额度用完后只能一次性减到一。",
  "pitfalls": [
    "起点一不计行动",
    "翻倍次数是上限",
    "逆向遇奇数必须先减一"
  ],
  "solutions": [
    {
      "id": "reverse-greedy-halving",
      "title": "逆向贪心折半",
      "kind": "最优",
      "idea": "把正向翻倍转成逆向除二以最大化每次缩减。",
      "steps": [
        "moves=0",
        "while target>1 且 doubles>0：偶数则 target/=2、doubles--，奇数 target--；moves++",
        "额度耗尽后 moves+=target-1"
      ],
      "complexity": {
        "time": "O(log target+remaining decrements)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/reverse-greedy-halving/Solution.java",
        "kotlin": "solutions/reverse-greedy-halving/Solution.kt",
        "cpp": "solutions/reverse-greedy-halving/solution.cpp"
      }
    }
  ]
}
