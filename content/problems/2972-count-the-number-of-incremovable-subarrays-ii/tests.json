{
  "schemaVersion": 1,
  "mode": "function",
  "method": "incremovableSubarrayCount",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "严格递增数组的每个非空子数组都可移除",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 10
    },
    {
      "name": "六五断点与递增后缀产生七种方案",
      "args": [
        [
          6,
          5,
          7,
          8
        ]
      ],
      "expected": 7
    },
    {
      "name": "末尾相等阻断递增后缀只剩三种方案",
      "args": [
        [
          8,
          7,
          6,
          6
        ]
      ],
      "expected": 3
    },
    {
      "name": "单元素只能移除它本身",
      "args": [
        [
          5
        ]
      ],
      "expected": 1
    },
    {
      "name": "中间下降时双指针桥接得到十种方案",
      "args": [
        [
          1,
          2,
          5,
          3,
          4
        ]
      ],
      "expected": 10
    }
  ]
}
