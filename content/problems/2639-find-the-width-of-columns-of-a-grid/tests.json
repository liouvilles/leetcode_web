      "args": [
        [
          [
            1
          ],
          [
            22
          ],
          [
            333
          ]
        ]
      ],
      "expected": [
        3
      ]
    },
    {
      "name": "负号与两位数决定各列宽度",
      "args": [
        [
          [
            -15,
            1,
            3
          ],
          [
            15,
            7,
            12
          ],
          [
            5,
            6,
            -2
          ]
        ]
      ],
      "expected": [
        3,
        1,
        2
      ]
    },
    {
      "name": "零与负一的宽度",
      "args": [
        [
          [
            0,
            -1
          ]
        ]
      ],
      "expected": [
        1,
        2
      ]
    }
  ]
