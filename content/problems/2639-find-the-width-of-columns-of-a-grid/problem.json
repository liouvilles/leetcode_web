      "idea": "直接枚举所有单元格更新列最大值。",
      "steps": [
        "answer 长度为列数",
        "遍历每一行和列",
        "width=toString(grid[row][col]).length",
        "answer[col]=max(answer[col],width)",
        "返回 answer"
      ],
