        "dsahjpjauf",
        [
          "ahjpjau",
          "ja",
          "ahbwzgqnuk",
          "tnmlanowax"
        ]
      ],
      "expected": 2
    },
    {
      "name": "重复单词分别计数",
      "args": [
        "abc",
        [
          "a",
          "a",
          "b"
        ]
      ],
      "expected": 3
    }
  ]
}
