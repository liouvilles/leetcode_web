{
  "schemaVersion": 1,
  "mode": "function",
  "method": "countQuadruplets",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "两个不同末点组成上升四元组",
      "args": [
        [
          1,
          3,
          2,
          4,
          5
        ]
      ],
      "expected": 2
    },
    {
      "name": "完全递增数组不满足中间逆序",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 0
    },
    {
      "name": "一三二四恰有一个四元组",
      "args": [
        [
          1,
          3,
          2,
          4
        ]
      ],
      "expected": 1
    }
  ]
}
