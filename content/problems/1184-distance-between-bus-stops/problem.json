  "summary": "环形公交线路相邻站距离已知，求两个站点之间沿任一方向行驶的较短距离。",
  "insight": "从较小站号到较大站号累加得到一个方向距离 direct，另一个方向就是总环长减 direct，取二者最小。",
  "pitfalls": [
    "起点可能大于终点，先交换便于统一处理",
    "distance[i] 连接 i 与 (i+1)%n",
    "起终点相同距离为零"
  ],
  "solutions": [
    {
      "id": "arc-sum-and-complement",
      "title": "弧长与补弧",
      "kind": "最优",
      "idea": "计算一段连续弧和总环长。",
      "steps": [
        "若 start>end 则交换",
        "total 为 distance 全部之和，direct 为下标 start..end-1 之和",
        "返回 min(direct,total-direct)"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/arc-sum-and-complement/Solution.java",
        "kotlin": "solutions/arc-sum-and-complement/Solution.kt",
        "cpp": "solutions/arc-sum-and-complement/solution.cpp"
      }
    }
  ]
