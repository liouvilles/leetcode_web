    {
      "id": "dfs-by-depth",
      "title": "按深度分组 DFS",
      "kind": "进阶",
      "idea": "深度优先访问时携带 depth，把同一深度的结点追加到同一个列表。",
      "steps": [
        "首次到达 depth 时创建列表",
        "把当前值加入 result[depth]",
        "依次递归左右子树并令深度加一"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(h)"
      },
