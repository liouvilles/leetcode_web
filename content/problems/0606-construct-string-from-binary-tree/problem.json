  "solutions": [
    {
      "id": "preorder-parentheses",
      "title": "前序递归按需添加括号",
      "kind": "最优",
      "idea": "递归输出节点，并根据孩子存在情况决定左右括号。",
      "steps": [
        "输出当前节点值",
        "若存在左或右孩子，输出 (left)",
        "若存在右孩子，再输出 (right)"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(h)"
