  "summary": "长度为 n 的数字字符串中，偶数下标放偶数字、奇数下标放质数数字，求数量并取模。",
  "insight": "偶数下标有五种选择，奇数下标有四种。答案是 5^ceil(n/2)·4^floor(n/2)，用快速幂处理长整型 n。",
  "pitfalls": [
    "下标从零开始",
    "字符串可有前导零",
    "n 使用 long"
  ],
  "solutions": [
    {
      "id": "modular-fast-powers",
      "title": "组合乘积与模快速幂",
      "kind": "最优",
      "idea": "分别计算两类位置的选择数幂。",
      "steps": [
        "evenPositions=(n+1)/2，oddPositions=n/2",
        "快速幂求 5^evenPositions 与 4^oddPositions",
        "相乘取模返回"
      ],
      "complexity": {
        "time": "O(log n)",
        "space": "O(1)"
      },
