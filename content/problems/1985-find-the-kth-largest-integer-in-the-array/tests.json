          "3",
          "6",
          "7",
          "10"
        ],
        4
      ],
      "expected": "3"
    },
    {
      "name": "第三大为二",
      "args": [
        [
          "2",
          "21",
          "12",
          "1"
        ],
        3
      ],
      "expected": "2"
    },
    {
      "name": "重复三分别占排名",
      "args": [
        [
          "0",
          "0"
        ],
        2
      ],
      "expected": "0"
    }
  ]
}
