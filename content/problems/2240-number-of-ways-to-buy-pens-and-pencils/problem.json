  "solutions": [
    {
      "id": "enumerate-first-item-count",
      "title": "枚举钢笔数量",
      "kind": "最优",
      "idea": "固定一种物品数量后直接计算另一种的可选数量。",
      "steps": [
        "ways=0",
        "pens 从零到 total/cost1",
        "remaining=total-pens*cost1，ways+=remaining/cost2+1；返回 ways"
      ],
      "complexity": {
        "time": "O(total/cost1)",
        "space": "O(1)"
      },
