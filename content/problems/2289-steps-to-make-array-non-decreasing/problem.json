        "java": "solutions/monotonic-stack-removal-rounds/Solution.java",
        "kotlin": "solutions/monotonic-stack-removal-rounds/Solution.kt",
        "cpp": "solutions/monotonic-stack-removal-rounds/solution.cpp"
      }
    }
  ]
