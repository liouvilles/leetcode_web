  ],
  "summary": "按“左子树、根结点、右子树”的顺序返回二叉树所有结点值。",
  "insight": "递归调用栈和显式栈本质相同；Morris 则把空闲的右指针临时改造成返回路径。",
  "pitfalls": [
    "访问根结点的时机在左子树之后",
    "迭代时外层条件要包含栈非空",
    "Morris 结束前必须恢复树结构"
  ],
  "solutions": [
    {
      "id": "recursive",
      "title": "递归 DFS",
      "kind": "基础",
      "idea": "严格按照左、根、右的顺序递归访问并写入结果。",
      "steps": [
        "递归访问左子树",
        "记录当前结点",
        "递归访问右子树"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(h)"
      },
      "files": {
        "java": "solutions/recursive/Solution.java",
        "kotlin": "solutions/recursive/Solution.kt",
        "cpp": "solutions/recursive/solution.cpp"
      }
    },
    {
      "id": "iterative-stack",
      "title": "显式栈迭代",
      "kind": "进阶",
      "idea": "不断把左链压栈，栈顶就是下一个应访问的结点。",
      "steps": [
        "沿左指针压入所有结点",
        "弹出栈顶并记录",
        "转向它的右子树重复过程"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(h)"
      },
      "files": {
        "java": "solutions/iterative-stack/Solution.java",
        "kotlin": "solutions/iterative-stack/Solution.kt",
        "cpp": "solutions/iterative-stack/solution.cpp"
      }
    },
    {
      "id": "morris",
      "title": "Morris 线索遍历",
      "kind": "最优",
      "idea": "利用左子树最右结点的空 right 指针建立临时返回路径，实现常数额外空间。",
      "steps": [
        "无左子树时直接访问并向右",
        "首次找到前驱时建立前驱到当前结点的线索",
        "再次遇到线索时恢复 null、访问当前结点并向右"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/morris/Solution.java",
        "kotlin": "solutions/morris/Solution.kt",
        "cpp": "solutions/morris/solution.cpp"
      }
    }
  ]
