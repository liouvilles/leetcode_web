    {
      "id": "sort-pair-extremes",
      "title": "排序后首尾配对",
      "kind": "最优",
      "idea": "用强弱互补压低最坏数对和。",
      "steps": [
        "升序排序",
        "left=0、right=n-1",
        "更新 max(nums[left]+nums[right]) 后双向收缩，返回"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(log n)"
