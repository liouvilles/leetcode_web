{
  "schemaVersion": 1,
  "mode": "function",
  "method": "countMatchingSubarrays",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "严格上升关系的重叠匹配共有四个",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        [
          1,
          1
        ]
      ],
      "expected": 4
    },
    {
      "name": "两段上升相等下降关系均被找到",
      "args": [
        [
          1,
          4,
          4,
          1,
          3,
          5,
          5,
          3
        ],
        [
          1,
          0,
          -1
        ]
      ],
      "expected": 2
    },
    {
      "name": "相等下降相等只在开头出现一次",
      "args": [
        [
          5,
          5,
          4,
          4,
          5
        ],
        [
          0,
          -1,
          0
        ]
      ],
      "expected": 1
    },
    {
      "name": "长度一模式可匹配每个上升位置",
      "args": [
        [
          1,
          2,
          3,
          4
        ],
        [
          1
        ]
      ],
      "expected": 3
    },
    {
      "name": "下降数组中不存在上升关系",
      "args": [
        [
          4,
          3,
          2
        ],
        [
          1
        ]
      ],
      "expected": 0
    },
    {
      "name": "模式覆盖整个关系序列时恰好匹配一次",
      "args": [
        [
          3,
          2,
          2,
          4
        ],
        [
          -1,
          0,
          1
        ]
      ],
      "expected": 1
    }
  ]
}
