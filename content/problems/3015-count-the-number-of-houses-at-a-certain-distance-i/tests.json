{
  "schemaVersion": 1,
  "mode": "function",
  "method": "countOfPairs",
  "parameterTypes": [
    "int",
    "int",
    "int"
  ],
  "returnType": "intArray",
  "cases": [
    {
      "name": "三座房屋首尾相连后所有点对距离为一",
      "args": [
        3,
        1,
        3
      ],
      "expected": [
        6,
        0,
        0
      ]
    },
    {
      "name": "五座房屋二四相连产生距离一二三的点对",
      "args": [
        5,
        2,
        4
      ],
      "expected": [
        10,
        8,
        2,
        0,
        0
      ]
    },
    {
      "name": "额外街道连接同一房屋时退化为直线",
      "args": [
        4,
        1,
        1
      ],
      "expected": [
        6,
        4,
        2,
        0
      ]
    },
    {
      "name": "连接相邻房屋不会改变直线路径距离",
      "args": [
        5,
        2,
        3
      ],
      "expected": [
        8,
        6,
        4,
        2,
        0
      ]
    },
    {
      "name": "反向给出五与二仍按无向额外街道统计",
      "args": [
        6,
        5,
        2
      ],
      "expected": [
        12,
        12,
        6,
        0,
        0,
        0
      ]
    }
  ]
}
