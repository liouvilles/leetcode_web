{
  "schemaVersion": 1,
  "mode": "function",
  "method": "groupAnagrams",
  "parameterTypes": [
    "stringArray"
  ],
  "returnType": "stringListMatrix",
  "cases": [
    {
      "name": "三个异位词分组",
      "args": [
        [
          "eat",
          "tea",
          "tan",
          "ate",
          "nat",
          "bat"
        ]
      ],
      "expected": [
        [
          "eat",
          "tea",
          "ate"
        ],
        [
          "tan",
          "nat"
        ],
        [
          "bat"
        ]
      ]
    },
    {
      "name": "空字符串单独成组",
      "args": [
        [
          ""
        ]
      ],
      "expected": [
        [
          ""
        ]
      ]
    },
    {
      "name": "单字符字符串",
      "args": [
        [
          "a"
        ]
      ],
      "expected": [
        [
          "a"
        ]
      ]
    }
  ]
}
