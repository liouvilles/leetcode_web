    {
      "id": "positive-suffix-greedy",
      "title": "正后缀贪心",
      "kind": "最优",
      "idea": "从高到低扩张被选后缀并累计每次整体时移收益。",
      "steps": [
        "升序排序 satisfaction",
        "从末尾向前更新 suffix+=value",
        "suffix<=0 时停止，否则 answer+=suffix"
