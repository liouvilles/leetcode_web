      "args": [
        [
          1,
          3,
          4,
          8,
          7,
          9,
          3,
          5,
          1
        ],
        2
      ],
      "expected": [
        [
          1,
          1,
          3
        ],
        [
          3,
          4,
          5
        ],
        [
          7,
          8,
          9
        ]
      ]
    },
    {
      "name": "四个二导致剩余五无法合法分组",
      "args": [
        [
          2,
          4,
          2,
          2,
          5,
          2
        ],
        2
      ],
      "expected": []
    },
    {
      "name": "单组三个元素恰好达到差值上限",
      "args": [
        [
          3,
          1,
          2
        ],
        2
      ],
      "expected": [
        [
          1,
          2,
          3
        ]
      ]
    },
    {
      "name": "乱序的六个连续整数分成两组",
      "args": [
        [
          6,
          4,
          5,
          3,
          1,
          2
        ],
        2
      ],
      "expected": [
        [
          1,
          2,
          3
        ],
        [
          4,
          5,
          6
        ]
      ]
    },
    {
      "name": "最小连续三元组超过限制时失败",
      "args": [
        [
          1,
          1,
          3
        ],
        1
      ],
      "expected": []
    }
  ]
}
