  "studyTags": [
    "数组"
  ],
  "summary": "判断数组是否整体单调不减或整体单调不增。",
  "insight": "扫描相邻元素，分别记录是否出现过上升和下降；一旦两者都出现就不可能单调。",
  "pitfalls": [
    "相等元素同时兼容两种单调性",
    "长度一一定单调",
    "无需预先判断方向"
  ],
  "solutions": [
    {
      "id": "track-rise-and-fall",
      "title": "记录上升与下降",
      "kind": "最优",
      "idea": "一次扫描检测是否同时存在两种严格变化。",
      "steps": [
        "increasing=false,decreasing=false",
        "若 nums[i]>nums[i-1] 标记 increasing，若小于标记 decreasing",
        "若两标记都真返回假，扫描结束返回真"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/track-rise-and-fall/Solution.java",
        "kotlin": "solutions/track-rise-and-fall/Solution.kt",
        "cpp": "solutions/track-rise-and-fall/solution.cpp"
      }
    }
  ]
}
