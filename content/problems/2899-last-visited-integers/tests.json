{
  "schemaVersion": 1,
  "mode": "function",
  "method": "lastVisitedIntegers",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "intList",
  "cases": [
    {
      "name": "连续三次查询依次返回二一负一",
      "args": [
        [
          1,
          2,
          -1,
          -1,
          -1
        ]
      ],
      "expected": [
        2,
        1,
        -1
      ]
    },
    {
      "name": "新整数会重置查询位置",
      "args": [
        [
          1,
          -1,
          2,
          -1,
          -1
        ]
      ],
      "expected": [
        1,
        2,
        1
      ]
    },
    {
      "name": "没有历史时查询返回负一",
      "args": [
        [
          -1
        ]
      ],
      "expected": [
        -1
      ]
    }
  ]
}
