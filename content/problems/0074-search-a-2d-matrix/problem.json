    {
      "id": "flattened-binary-search",
      "title": "虚拟展开二分",
      "kind": "最优",
      "idea": "不复制矩阵，只用坐标换算在虚拟一维数组上二分。",
      "steps": [
        "建立 [0,mn-1] 闭区间",
        "把中点换算成行列坐标",
        "根据中点值更新二分边界"
      ],
      "complexity": {
        "time": "O(log(mn))",
        "space": "O(1)"
      },
