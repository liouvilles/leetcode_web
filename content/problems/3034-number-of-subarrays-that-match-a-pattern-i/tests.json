{
  "schemaVersion": 1,
  "mode": "function",
  "method": "countMatchingSubarrays",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "六个递增数包含四个长度三窗口",
      "args": [
        [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        [
          1,
          1
        ]
      ],
      "expected": 4
    },
    {
      "name": "复杂关系模式在首尾各匹配一次",
      "args": [
        [
          1,
          4,
          4,
          1,
          3,
          5,
          5,
          3
        ],
        [
          1,
          0,
          -1
        ]
      ],
      "expected": 2
    },
    {
      "name": "严格递减三元素完整匹配",
      "args": [
        [
          3,
          2,
          1
        ],
        [
          -1,
          -1
        ]
      ],
      "expected": 1
    },
    {
      "name": "四个相等数含两个长度三窗口",
      "args": [
        [
          1,
          1,
          1,
          1
        ],
        [
          0,
          0
        ]
      ],
      "expected": 2
    },
    {
      "name": "上升下降再上升模式只匹配全数组",
      "args": [
        [
          1,
          3,
          2,
          4
        ],
        [
          1,
          -1,
          1
        ]
      ],
      "expected": 1
    }
  ]
}
