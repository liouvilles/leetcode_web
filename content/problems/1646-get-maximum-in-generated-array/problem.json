      "steps": [
        "n==0 返回零，初始化 nums[1]=1、answer=1",
        "i 从二到 n：偶数复制 nums[i/2]，奇数相加",
        "用生成值更新 answer 并返回"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
