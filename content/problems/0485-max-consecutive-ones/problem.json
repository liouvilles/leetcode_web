      "id": "running-streak",
      "title": "当前连续段计数",
      "kind": "最优",
      "idea": "单次扫描维护 current 和 best。",
      "steps": [
        "current=best=0",
        "value==1 时 current++，否则 current=0",
        "best=max(best,current)"
