{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findThePrefixCommonArray",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "intArray",
  "cases": [
    {
      "name": "第二位后已有两个公共数字",
      "args": [
        [
          1,
          3,
          2,
          4
        ],
        [
          3,
          1,
          2,
          4
        ]
      ],
      "expected": [
        0,
        2,
        3,
        4
      ]
    },
    {
      "name": "三个位置逐步形成零一三",
      "args": [
        [
          2,
          3,
          1
        ],
        [
          3,
          1,
          2
        ]
      ],
      "expected": [
        0,
        1,
        3
      ]
    },
    {
      "name": "相同排列每步公共数加一",
      "args": [
        [
          1,
          2
        ],
        [
          1,
          2
        ]
      ],
      "expected": [
        1,
        2
      ]
    }
  ]
}
