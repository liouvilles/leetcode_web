  "solutions": [
    {
      "id": "component-two-color-bfs",
      "title": "连通分量双色 BFS",
      "kind": "最优",
      "idea": "逐分量染成正负两色并检查冲突。",
      "steps": [
        "建立 1..n 无向邻接表，color 初始零",
        "对每个未染色 person 设一并入队",
        "弹出节点，对邻居：未染色设为相反色；若已同色返回假，全部完成返回真"
      ],
      "complexity": {
        "time": "O(n+e)",
        "space": "O(n+e)"
      },
