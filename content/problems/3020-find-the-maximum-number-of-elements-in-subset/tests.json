{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maximumLength",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "两个二和一个四组成长度三平方链",
      "args": [
        [
          5,
          4,
          1,
          2,
          2
        ]
      ],
      "expected": 3
    },
    {
      "name": "所有值都只有一个副本",
      "args": [
        [
          1,
          3,
          2,
          4
        ]
      ],
      "expected": 1
    },
    {
      "name": "四个一只能选最大奇数三个",
      "args": [
        [
          1,
          1,
          1,
          1
        ]
      ],
      "expected": 3
    },
    {
      "name": "二四各一对且十六为中心",
      "args": [
        [
          2,
          2,
          4,
          4,
          16
        ]
      ],
      "expected": 5
    },
    {
      "name": "五层完整平方链",
      "args": [
        [
          2,
          2,
          4,
          4,
          16,
          16,
          256,
          256,
          65536
        ]
      ],
      "expected": 9
    },
    {
      "name": "平方超出整数范围且没有下一层",
      "args": [
        [
          1000000000,
          1000000000
        ]
      ],
      "expected": 1
    }
  ]
}
