{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findNumOfValidWords",
  "parameterTypes": [
    "stringArray",
    "stringArray"
  ],
  "returnType": "intList",
  "cases": [
    {
      "name": "经典六个谜面",
      "args": [
        [
          "aaaa",
          "asas",
          "able",
          "ability",
          "actt",
          "actor",
          "access"
        ],
        [
          "aboveyz",
          "abrodyz",
          "abslute",
          "absoryz",
          "actresz",
          "gaswxyz"
        ]
      ],
      "expected": [
        1,
        1,
        3,
        2,
        4,
        0
      ]
    },
    {
      "name": "首字母约束",
      "args": [
        [
          "apple",
          "pleas",
          "please"
        ],
        [
          "aelwxyz",
          "aelpxyz",
          "aelpsxy",
          "saelpxy",
          "xaelpsy"
        ]
      ],
      "expected": [
        0,
        1,
        3,
        2,
        0
      ]
    },
    {
      "name": "重复单词重复计数",
      "args": [
        [
          "a",
          "a",
          "b"
        ],
        [
          "abcdefg"
        ]
      ],
      "expected": [
        2
