{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minimumArrayLength",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "最小值一出现两次可最终只留一个零",
      "args": [
        [
          1,
          4,
          3,
          1
        ]
      ],
      "expected": 1
    },
    {
      "name": "四个最小值两两取模留下两个零",
      "args": [
        [
          5,
          5,
          5,
          10,
          5
        ]
      ],
      "expected": 2
    },
    {
      "name": "三不能被最小值二整除所以答案为一",
      "args": [
        [
          2,
          3,
          4
        ]
      ],
      "expected": 1
    },
    {
      "name": "三个最小值需要向上取整",
      "args": [
        [
          2,
          2,
          2,
          4
        ]
      ],
      "expected": 2
    },
    {
      "name": "单元素数组无法执行操作",
      "args": [
        [
          7
        ]
      ],
      "expected": 1
    },
    {
      "name": "所有元素的最大公约数小于最小值",
      "args": [
        [
          6,
          10,
          14
        ]
      ],
      "expected": 1
    }
  ]
}
