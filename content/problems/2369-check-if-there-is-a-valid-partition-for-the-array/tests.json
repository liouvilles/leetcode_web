  "cases": [
    {
      "name": "三等值加连续三元组可划分",
      "args": [
        [
          4,
          4,
          4,
          5,
          6
        ]
      ],
      "expected": true
    },
    {
      "name": "末尾单元素无法划分",
      "args": [
        [
          1,
          1,
          1,
          2
        ]
      ],
      "expected": false
    },
    {
      "name": "两个相等元素有效",
      "args": [
        [
          1,
          1
        ]
      ],
      "expected": true
    }
  ]
}
