{
  "schemaVersion": 1,
  "mode": "function",
  "method": "findIntersectionValues",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "intArray",
  "cases": [
    {
      "name": "重复的二在第一个数组中逐个计数",
      "args": [
        [
          4,
          3,
          2,
          3,
          1
        ],
        [
          2,
          2,
          5,
          2,
          3,
          6
        ]
      ],
      "expected": [
        3,
        4
      ]
    },
    {
      "name": "两个数组没有公共值",
      "args": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ],
      "expected": [
        0,
        0
      ]
    },
    {
      "name": "单个相同元素双向各计一次",
      "args": [
        [
          7
        ],
        [
          7
        ]
      ],
      "expected": [
        1,
        1
      ]
    },
    {
      "name": "第二数组重复三次均被计数",
      "args": [
        [
          1,
          2
        ],
        [
          2,
          2,
          2
        ]
      ],
      "expected": [
        1,
        3
      ]
    }
  ]
}
