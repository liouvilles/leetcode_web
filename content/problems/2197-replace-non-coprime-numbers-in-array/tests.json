        [
          2,
          2,
          1,
          1,
          3,
          3,
          3
        ]
      ],
      "expected": [
        2,
        1,
        1,
        3
      ]
    },
    {
      "name": "全部互质保持不变",
      "args": [
        [
          5,
          7,
          11
        ]
      ],
      "expected": [
        5,
        7,
        11
      ]
    }
  ]
