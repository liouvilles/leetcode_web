{
  "schemaVersion": 1,
  "mode": "function",
  "method": "longestConsecutive",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "乱序数组包含四个连续值",
      "args": [
        [
          100,
          4,
          200,
          1,
          3,
          2
        ]
      ],
      "expected": 4
    },
    {
      "name": "重复元素不增加长度",
      "args": [
        [
          0,
          3,
          7,
          2,
          5,
          8,
          4,
          6,
          0,
          1
        ]
      ],
      "expected": 9
    },
    {
      "name": "空数组",
      "args": [
        []
      ],
      "expected": 0
    }
  ]
}
