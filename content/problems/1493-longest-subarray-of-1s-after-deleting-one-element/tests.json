          1,
          1,
          0,
          1,
          1,
          0,
          1
        ]
      ],
      "expected": 5
    },
    {
      "name": "全一数组必须删一个",
      "args": [
        [
          1,
          1,
          1
        ]
      ],
      "expected": 2
    }
  ]
}
