  "slug": "delete-columns-to-make-sorted",
  "title": "删列造序",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-013",
  "studyTags": [
    "数组",
    "字符串"
  ],
  "summary": "等长字符串按行排成网格，删除最少列，使每个保留列从上到下非递减。",
  "insight": "各列互不影响；只要某列存在相邻两行逆序，这一列就必须删除，否则可以保留。",
  "pitfalls": [
    "要求的是每一列纵向有序，不是行之间字典序",
    "相等字符不构成逆序",
    "只需比较相邻行即可发现任意逆序"
  ],
  "solutions": [
    {
      "id": "independent-column-scan",
      "title": "逐列独立扫描",
      "kind": "最优",
      "idea": "统计含纵向逆序的列。",
      "steps": [
        "deleted=0",
        "对每个列 col，扫描 row=1..m-1",
        "若 strs[row-1][col]>strs[row][col]，deleted++ 并检查下一列；返回 deleted"
      ],
      "complexity": {
        "time": "O(rows·cols)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/independent-column-scan/Solution.java",
        "kotlin": "solutions/independent-column-scan/Solution.kt",
        "cpp": "solutions/independent-column-scan/solution.cpp"
      }
    }
  ]
}
