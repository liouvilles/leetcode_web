{
  "schemaVersion": 1,
  "mode": "function",
  "method": "modifiedMatrix",
  "parameterTypes": [
    "intMatrix"
  ],
  "returnType": "intMatrix",
  "cases": [
    {
      "name": "每列负一分别替换成列最大值",
      "args": [
        [
          [
            -1,
            2,
            -1
          ],
          [
            3,
            -1,
            4
          ]
        ]
      ],
      "expected": [
        [
          3,
          2,
          4
        ],
        [
          3,
          2,
          4
        ]
      ]
    },
    {
      "name": "没有负一时矩阵保持不变",
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          3,
          4
        ]
      ]
    },
    {
      "name": "零是第一列合法最大替换值",
      "args": [
        [
          [
            -1,
            -1
          ],
          [
            0,
            5
          ]
        ]
      ],
      "expected": [
        [
          0,
          5
        ],
        [
          0,
          5
        ]
      ]
    },
    {
      "name": "多个负一共享各自列最大值",
      "args": [
        [
          [
            -1,
            100
          ],
          [
            50,
            -1
          ],
          [
            -1,
            20
          ]
        ]
      ],
      "expected": [
        [
          50,
          100
        ],
        [
          50,
          100
        ],
        [
          50,
          20
        ]
      ]
    }
  ]
}
