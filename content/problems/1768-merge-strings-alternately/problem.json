  "summary": "从 word1 开始交替取两个字符串的字符，一侧用尽后追加另一侧剩余字符。",
  "insight": "用同一下标依次追加两串存在的第 i 个字符，自然实现交替和尾部补齐。",
  "pitfalls": [
    "第一字符来自 word1",
    "两串长度可不同",
    "保持各自字符相对顺序"
  ],
  "solutions": [
    {
      "id": "single-index-interleave",
      "title": "单下标交织",
      "kind": "最优",
      "idea": "逐位置分别检查两串是否还有字符。",
      "steps": [
        "builder 为空",
        "i 从零到 max(length1,length2)-1",
        "i<word1.length 则追加 word1[i]，i<word2.length 则追加 word2[i]"
      ],
      "complexity": {
        "time": "O(m+n)",
        "space": "O(m+n)"
      },
      "files": {
        "java": "solutions/single-index-interleave/Solution.java",
        "kotlin": "solutions/single-index-interleave/Solution.kt",
        "cpp": "solutions/single-index-interleave/solution.cpp"
      }
    }
  ]
}
