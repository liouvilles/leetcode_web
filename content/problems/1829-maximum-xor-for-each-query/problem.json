  "summary": "每次查询选择 k<2^maximumBit，使当前 nums 全体异或再 xor k 最大，然后删除 nums 最后一个元素，返回各次 k。",
  "insight": "在 maximumBit 位范围内，使 x xor k 最大的 k 就是 x 的按位补码，即 x xor mask。维护当前全体异或，回答后异或删除尾元素以移除它。",
  "pitfalls": [
    "答案顺序对应逐次删除过程",
    "mask=(1<<maximumBit)-1",
    "异或同一尾元素可将其从总异或中消去"
  ],
  "solutions": [
    {
      "id": "rolling-xor-bit-complement",
      "title": "滚动异或与位补码",
      "kind": "最优",
      "idea": "每轮用有限位掩码翻转当前异或的所有位。",
      "steps": [
        "current=XOR(nums)，mask=2^maximumBit-1",
        "query 从零到 n-1：answer[query]=current xor mask",
        "current xor=nums[n-1-query]，返回 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/rolling-xor-bit-complement/Solution.java",
        "kotlin": "solutions/rolling-xor-bit-complement/Solution.kt",
        "cpp": "solutions/rolling-xor-bit-complement/solution.cpp"
      }
    }
  ]
}
