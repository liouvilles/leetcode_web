    {
      "id": "row-scan-count-ones",
      "title": "逐行计数一",
      "kind": "最优",
      "idea": "维护严格更大的最佳行。",
      "steps": [
        "bestRow=bestCount=0",
        "从 row=0 开始",
        "累加该行所有值",
        "若 count>bestCount，更新行号与计数",
        "返回 [bestRow,bestCount]"
      ],
