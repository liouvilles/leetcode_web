        1,
        4,
        3
      ]
    },
    {
      "name": "空链表",
      "args": [
        []
      ],
      "expected": []
    },
    {
      "name": "奇数个节点保留末尾",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        2,
        1,
        3
      ]
    }
  ]
