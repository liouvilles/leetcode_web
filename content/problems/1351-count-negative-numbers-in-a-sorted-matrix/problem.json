  "schemaVersion": 1,
  "id": 1351,
  "slug": "count-negative-numbers-in-a-sorted-matrix",
  "title": "统计有序矩阵中的负数",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-019",
  "studyTags": [
    "数组",
    "矩阵",
    "双指针"
  ],
  "summary": "矩阵每行、每列都按非递增顺序排列，统计所有负数数量。",
  "insight": "从右上角开始：若当前值为负，则该列从当前行到末行都为负，累加 rows-row 并左移；否则下移寻找更小值。",
  "pitfalls": [
    "排序方向是非递增",
    "零不算负数",
    "每次可批量计一列的后缀"
  ],
  "solutions": [
    {
      "id": "top-right-staircase",
      "title": "右上角阶梯扫描",
      "kind": "最优",
      "idea": "利用行列单调性一次排除一行或统计一列。",
      "steps": [
        "row=0,column=last,answer=0",
        "当未越界，若 grid[row][column]<0，answer+=rows-row、column--",
        "否则 row++；返回 answer"
      ],
      "complexity": {
        "time": "O(rows+columns)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/top-right-staircase/Solution.java",
        "kotlin": "solutions/top-right-staircase/Solution.kt",
        "cpp": "solutions/top-right-staircase/solution.cpp"
      }
    }
  ]
}
