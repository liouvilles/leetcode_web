{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minSum",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "两边最小和均为十二",
      "args": [
        [
          3,
          2,
          0,
          1,
          0
        ],
        [
          6,
          5,
          0
        ]
      ],
      "expected": 12
    },
    {
      "name": "较小固定和无法追上返回负一",
      "args": [
        [
          2,
          0,
          2,
          0
        ],
        [
          1,
          4
        ]
      ],
      "expected": -1
    },
    {
      "name": "两个固定数组的总和已经相等",
      "args": [
        [
          1,
          2
        ],
        [
          3
        ]
      ],
      "expected": 3
    },
    {
      "name": "单个零可增大到另一数组的固定和",
      "args": [
        [
          0
        ],
        [
          5
        ]
      ],
      "expected": 5
    },
    {
      "name": "较大最小和一侧也含零仍取较大值",
      "args": [
        [
          1000000,
          0
        ],
        [
          1,
          0
        ]
      ],
      "expected": 1000001
    },
    {
      "name": "两个固定数组和不等时无解",
      "args": [
        [
          1
        ],
        [
          2
        ]
      ],
      "expected": -1
    }
  ]
}
