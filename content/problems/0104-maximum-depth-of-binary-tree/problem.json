  "summary": "求从根结点到最远叶子结点的最长路径所包含的结点数。",
  "insight": "一棵非空树的高度等于左右子树较大高度加一。",
  "pitfalls": [
    "空树深度为 0",
    "题目计算结点数而不是边数",
    "极端链状树会产生 O(n) 递归深度"
  ],
  "solutions": [
    {
      "id": "recursive-dfs",
      "title": "递归求树高",
      "kind": "最优",
      "idea": "递归获得左右子树高度，当前结点高度取较大者加一。",
      "steps": [
        "空结点返回 0",
        "递归计算左右高度",
        "返回 max(left, right) + 1"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(h)"
      },
      "files": {
        "java": "solutions/recursive-dfs/Solution.java",
        "kotlin": "solutions/recursive-dfs/Solution.kt",
        "cpp": "solutions/recursive-dfs/solution.cpp"
      }
    },
    {
      "id": "level-bfs",
      "title": "层序遍历计数",
      "kind": "进阶",
      "idea": "每完成一层 BFS 就把深度加一，最后处理的层就是最深层。",
      "steps": [
        "根结点入队",
        "按当前队列长度消费一整层",
        "加入子结点并递增深度"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(w)"
      },
      "files": {
        "java": "solutions/level-bfs/Solution.java",
