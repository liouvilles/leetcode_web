    {
      "id": "coverage-count-rearrangement",
      "title": "覆盖频次与重排不等式",
      "kind": "最优",
      "idea": "把元素值与位置权重各自排序后配对。",
      "steps": [
        "difference[n+1]，每请求 left++、right+1--",
        "前缀得到 frequency[n]",
        "排序 nums 与 frequency，累加 nums[i]*frequency[i] 取模"
      ],
