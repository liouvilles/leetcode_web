    {
      "id": "fenwick-tree",
      "title": "树状数组",
      "kind": "最优",
      "idea": "构造时逐点加入，更新和查询都只访问对数个节点。",
      "steps": [
        "values 保存当前元素",
        "add(index+1,delta) 更新树状数组",
        "sumRange=prefix(right+1)-prefix(left)"
      ],
