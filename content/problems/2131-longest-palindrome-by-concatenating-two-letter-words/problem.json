      "id": "pair-reversed-word-counts",
      "title": "反向单词配对计数",
      "kind": "最优",
      "idea": "按 26×26 频次数组直接计算可用对。",
      "steps": [
        "统计 count[first][second]",
        "对 a<b 累加 min(count[a][b],count[b][a])*4",
        "对 a==b 累加 count/2*4，并记录是否存在奇数剩余；有则最终加二"
      ],
      "complexity": {
        "time": "O(n+alphabet²)",
        "space": "O(alphabet²)"
