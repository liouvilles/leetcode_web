    {
      "id": "zero-indegree-vertices",
      "title": "零入度节点",
      "kind": "最优",
      "idea": "DAG 的最小覆盖起点恰是全部源点。",
      "steps": [
        "indegree[n]=0",
        "对每条 edge 增加 indegree[to]",
        "收集所有 indegree[node]==0 的 node"
      ],
      "complexity": {
        "time": "O(n+e)",
        "space": "O(n)"
