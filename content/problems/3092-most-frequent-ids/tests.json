{
  "schemaVersion": 1,
  "mode": "function",
  "method": "mostFrequentIDs",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "longArray",
  "cases": [
    {
      "name": "官方示例包含增加减少与最高频率切换",
      "args": [
        [
          2,
          3,
          2,
          1
        ],
        [
          3,
          2,
          -3,
          1
        ]
      ],
      "expected": [
        3,
        3,
        2,
        2
      ]
    },
    {
      "name": "唯一 ID 归零后新 ID 成为最高频",
      "args": [
        [
          5,
          5,
          3
        ],
        [
          2,
          -2,
          1
        ]
      ],
      "expected": [
        2,
        0,
        1
      ]
    },
    {
      "name": "并列最高频率与后续增长均正确处理",
      "args": [
        [
          1,
          2,
          1,
          2,
          3
        ],
        [
          5,
          5,
          -2,
          3,
          8
        ]
      ],
      "expected": [
        5,
        5,
        5,
        8,
        8
      ]
    },
    {
      "name": "两个 ID 最终都归零时返回零",
      "args": [
        [
          1,
          2,
          1,
          2
        ],
        [
          1,
          2,
          -1,
          -2
        ]
      ],
      "expected": [
        1,
        2,
        2,
        0
      ]
    },
    {
      "name": "频率下降后惰性删除旧的堆顶",
      "args": [
        [
          1,
          2,
          1
        ],
        [
          10,
          9,
          -5
        ]
      ],
      "expected": [
        10,
        10,
        9
      ]
    }
  ]
}
