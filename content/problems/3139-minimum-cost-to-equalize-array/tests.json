{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minCostToEqualizeArray",
  "parameterTypes": [
    "intArray",
    "int",
    "int"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "两个元素只能把较小值单独补到四",
      "args": [
        [
          4,
          1
        ],
        5,
        2
      ],
      "expected": 15
    },
    {
      "name": "双增便宜时五个元素总成本为六",
      "args": [
        [
          2,
          3,
          3,
          3,
          5
        ],
        2,
        1
      ],
      "expected": 6
    },
    {
      "name": "双增不如两次单增时全部使用单增",
      "args": [
        [
          3,
          5,
          3
        ],
        1,
        3
      ],
      "expected": 4
    },
    {
      "name": "奇数缺口提高目标一格可消除昂贵单增",
      "args": [
        [
          1,
          1,
          1,
          2,
          101
        ],
        100,
        1
      ],
      "expected": 202
    },
    {
      "name": "平衡目标四让三个低成本双增完成",
      "args": [
        [
          1,
          2,
          3
        ],
        1000000,
        1
      ],
      "expected": 3
    },
    {
      "name": "大成本结果在返回前正确取模",
      "args": [
        [
          1,
          1000000
        ],
        1000000,
        1
      ],
      "expected": 998993007
    }
  ]
