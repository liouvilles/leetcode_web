{
  "schemaVersion": 1,
  "mode": "function",
  "method": "reorderLogFiles",
  "parameterTypes": [
    "stringArray"
  ],
  "returnType": "stringArray",
  "cases": [
    {
      "name": "经典混合日志",
      "args": [
        [
          "dig1 8 1 5 1",
          "let1 art can",
          "dig2 3 6",
          "let2 own kit dig",
          "let3 art zero"
        ]
      ],
      "expected": [
        "let1 art can",
        "let3 art zero",
        "let2 own kit dig",
        "dig1 8 1 5 1",
        "dig2 3 6"
      ]
    },
    {
      "name": "内容相同按标识符",
      "args": [
        [
          "b act",
          "a act"
        ]
      ],
      "expected": [
        "a act",
        "b act"
      ]
    },
    {
      "name": "数字日志保持顺序",
      "args": [
        [
          "d1 2 3",
          "d2 1 4"
        ]
      ],
      "expected": [
        "d1 2 3",
        "d2 1 4"
      ]
    }
  ]
}
