  "summary": "三乘三网格共有九块石头，每次把一块移到相邻格，求最终每格恰好一块的最少移动次数。",
  "insight": "把每个多余石头按数量展开为来源列表，把空格作为目标列表，两者数量相同。任一来源到目标的最少移动是曼哈顿距离，因此问题变成最小代价完美匹配，可用目标掩码 DP。",
  "pitfalls": [
    "值为 c 的格子贡献 c-1 个多余来源",
    "来源和空格数量相同",
    "同一格多个多余石头要重复加入",
    "移动代价是曼哈顿距离"
  ],
  "solutions": [
    {
      "id": "bitmask-assignment-of-extra-stones",
      "title": "多余石头到空格的掩码匹配",
      "kind": "最优",
      "idea": "按来源顺序分配尚未使用的空格并记忆最小代价。",
      "steps": [
        "收集 extras 与 zeros 坐标",
        "memo[mask] 初始化未计算",
        "sourceIndex=bitCount(mask)",
        "枚举未使用 zero",
        "cost=曼哈顿距离+dfs(mask|bit)",
        "取最小并记忆",
        "返回 dfs(0)"
      ],
      "complexity": {
        "time": "O(z*2^z)",
        "space": "O(2^z)"
      },
      "files": {
        "java": "solutions/bitmask-assignment-of-extra-stones/Solution.java",
        "kotlin": "solutions/bitmask-assignment-of-extra-stones/Solution.kt",
        "cpp": "solutions/bitmask-assignment-of-extra-stones/solution.cpp"
      }
    }
  ]
}
