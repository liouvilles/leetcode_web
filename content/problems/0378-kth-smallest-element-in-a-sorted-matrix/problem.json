    {
      "id": "value-binary-search",
      "title": "数值域二分 + 阶梯计数",
      "kind": "最优",
      "idea": "利用有序矩阵在 O(n) 内计算不大于候选值的元素数量。",
      "steps": [
        "left=matrix[0][0], right=matrix[n-1][n-1]",
        "从左下角统计 <=middle 的数量",
        "count<k 时 left=middle+1，否则 right=middle，返回 left"
      ],
