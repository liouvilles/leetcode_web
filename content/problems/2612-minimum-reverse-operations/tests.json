{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minReverseOperations",
  "parameterTypes": [
    "int",
    "int",
    "intArray",
    "int"
  ],
  "returnType": "intArray",
  "cases": [
    {
      "name": "翻转整个数组一步到达三",
      "args": [
        4,
        0,
        [
          1,
          2
        ],
        4
      ],
      "expected": [
        0,
        -1,
        -1,
        1
      ]
    },
    {
      "name": "唯一候选落在禁止位置因而不可达",
      "args": [
        5,
        0,
        [
          2,
          4
        ],
        3
      ],
      "expected": [
        0,
        -1,
        -1,
        -1,
        -1
      ]
    },
    {
      "name": "长度一翻转不能移动",
      "args": [
        4,
        2,
        [
          0,
          1,
          3
        ],
        1
      ],
      "expected": [
        -1,
        -1,
        0,
        -1
      ]
    }
  ]
}
