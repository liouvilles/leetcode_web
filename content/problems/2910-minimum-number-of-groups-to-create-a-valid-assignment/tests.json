{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minGroupsForValidAssignment",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "频次三和二可各放一组",
      "args": [
        [
          3,
          2,
          3,
          2,
          3
        ]
      ],
      "expected": 2
    },
    {
      "name": "频次三一二需要四组",
      "args": [
        [
          10,
          10,
          10,
          3,
          1,
          1
        ]
      ],
      "expected": 4
    },
    {
      "name": "最小频次三不可行时退到组大小二",
      "args": [
        [
          1,
          1,
          1,
          1,
          1,
          2,
          2,
          2
        ]
      ],
      "expected": 3
    },
    {
      "name": "所有值相同只需一个组",
      "args": [
        [
          7,
          7,
          7,
          7,
          7,
          7
        ]
      ],
      "expected": 1
    },
    {
      "name": "所有球值不同必须各自一组",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 4
    }
  ]
}
