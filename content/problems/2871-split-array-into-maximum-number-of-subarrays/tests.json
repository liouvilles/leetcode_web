{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maxSubarrays",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "三个最短前缀的按位与均为零",
      "args": [
        [
          1,
          0,
          2,
          0,
          1,
          2
        ]
      ],
      "expected": 3
    },
    {
      "name": "整体按位与为一只能分一段",
      "args": [
        [
          5,
          7,
          1,
          3
        ]
      ],
      "expected": 1
    },
    {
      "name": "每个零都可单独成段",
      "args": [
        [
          0,
          0,
          0
        ]
      ],
      "expected": 3
    },
    {
      "name": "归零后的非零尾部需并入前段",
      "args": [
        [
          0,
          7
        ]
      ],
      "expected": 1
    }
  ]
}
