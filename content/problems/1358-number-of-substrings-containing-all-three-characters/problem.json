  "solutions": [
    {
      "id": "last-occurrence-minimum",
      "title": "最近位置最小值",
      "kind": "最优",
      "idea": "由三种字符最近位置中最早的一个确定合法起点上界。",
      "steps": [
        "last 三项初始化为 -1",
        "扫描 i，更新 s[i] 对应的 last",
        "answer += 1 + min(last)，返回 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
