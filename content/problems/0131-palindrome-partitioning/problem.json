    {
      "id": "palindrome-backtracking",
      "title": "枚举回文前缀回溯",
      "kind": "最优",
      "idea": "递归选择每个后缀的一个回文前缀，走到字符串末尾即形成方案。",
      "steps": [
        "枚举 end 从 start 到末尾",
        "双指针检查 s[start..end] 是否回文",
        "选择子串、递归 end+1、撤销选择"
      ],
      "complexity": {
        "time": "O(n·2^n)",
        "space": "O(n)"
