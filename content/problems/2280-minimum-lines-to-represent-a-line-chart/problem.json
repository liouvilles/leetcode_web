  "solutions": [
    {
      "id": "sort-and-cross-multiply-slopes",
      "title": "排序与斜率交叉乘",
      "kind": "最优",
      "idea": "统计有序点列中的斜率段数量。",
      "steps": [
        "按 day 排序，n==1 返回零",
        "answer=1",
        "i 从二到 n-1，若 (y_i-y_{i-1})*(x_{i-1}-x_{i-2}) != (y_{i-1}-y_{i-2})*(x_i-x_{i-1})，answer++"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(1) 或排序空间"
      },
