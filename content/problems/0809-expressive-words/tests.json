      "args": [
        "heeellooo",
        [
          "hello",
          "hi",
          "helo"
        ]
      ],
      "expected": 1
    },
    {
      "name": "两个长字符组",
      "args": [
        "zzzzzyyyyy",
        [
          "zzyy",
          "zy",
          "zyy"
        ]
      ],
      "expected": 3
    },
    {
      "name": "缺少末尾字符组",
      "args": [
        "abcd",
        [
          "abc"
        ]
      ],
      "expected": 0
    }
  ]
}
