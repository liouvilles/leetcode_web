        [
          -2,
          2
        ],
        -1
      ],
      "expected": 0
    },
    {
      "name": "两个相同差值构成一对",
      "args": [
        [
          1,
          1
        ],
        [
          0,
          0
        ],
        0
      ],
      "expected": 1
