{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minimumCost",
  "parameterTypes": [
    "string",
    "string",
    "stringArray",
    "stringArray",
    "intArray"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "单字符规则直接与间接转换共花二十八",
      "args": [
        "abcd",
        "acbe",
        [
          "a",
          "b",
          "c",
          "c",
          "e",
          "d"
        ],
        [
          "b",
          "c",
          "b",
          "e",
          "b",
          "e"
        ],
        [
          2,
          5,
          5,
          1,
          2,
          20
        ]
      ],
      "expected": 28
    },
    {
      "name": "两个相离三字符区间并让后一段连续转换",
      "args": [
        "abcdefgh",
        "acdeeghh",
        [
          "bcd",
          "fgh",
          "thh"
        ],
        [
          "cde",
          "thh",
          "ghh"
        ],
        [
          1,
          3,
          5
        ]
      ],
      "expected": 9
    },
    {
      "name": "两个所需区间相交但不相同时无法转换",
      "args": [
        "abcdefgh",
        "addddddd",
        [
          "bcd",
          "defgh"
        ],
        [
          "ddd",
          "ddddd"
        ],
        [
          100,
          1578
        ]
      ],
      "expected": -1
    },
    {
      "name": "每个 aa 经 cc 转为 bb 优于单字符和直接规则",
      "args": [
        "aaaa",
        "bbbb",
        [
          "a",
          "aa",
          "aa",
          "cc"
        ],
        [
          "b",
          "bb",
          "cc",
          "bb"
        ],
        [
          5,
          20,
          2,
          3
        ]
      ],
      "expected": 10
    },
    {
      "name": "整段多步转换优于直接转换",
      "args": [
        "ab",
        "cd",
        [
          "ab",
          "ab",
          "xb"
        ],
        [
          "cd",
          "xb",
          "cd"
        ],
        [
          10,
          2,
          3
        ]
      ],
      "expected": 5
    },
    {
      "name": "源串与目标串相同无需使用规则",
      "args": [
        "abc",
        "abc",
        [
          "a"
        ],
        [
          "b"
        ],
        [
          7
        ]
      ],
      "expected": 0
    }
  ]
}
