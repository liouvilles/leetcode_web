{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maxFrequencyScore",
  "parameterTypes": [
    "intArray",
    "long"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "三次操作可把一二四中的三个数统一",
      "args": [
        [
          1,
          2,
          6,
          4
        ],
        3
      ],
      "expected": 3
    },
    {
      "name": "零预算保留三个已有的四",
      "args": [
        [
          1,
          4,
          4,
          2,
          4
        ],
        0
      ],
      "expected": 3
    },
    {
      "name": "预算九只能统一一与十这两个数",
      "args": [
        [
          1,
          10,
          20
        ],
        9
      ],
      "expected": 2
    },
    {
      "name": "五个连续数统一到三恰用六次操作",
      "args": [
        [
          1,
          2,
          3,
          4,
          5
        ],
        6
      ],
      "expected": 5
    },
    {
      "name": "十亿级差值恰好可统一两个元素",
      "args": [
        [
          1,
          1000000000
        ],
        999999999
      ],
      "expected": 2
    }
  ]
}
