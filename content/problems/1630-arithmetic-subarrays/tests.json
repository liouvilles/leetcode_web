{
  "schemaVersion": 1,
  "mode": "function",
  "method": "checkArithmeticSubarrays",
  "parameterTypes": [
    "intArray",
    "intArray",
    "intArray"
  ],
  "returnType": "booleanList",
  "cases": [
    {
      "name": "三组区间两组可重排等差",
      "args": [
        [
          4,
          6,
          5,
          9,
          3,
          7
        ],
        [
          0,
          0,
          2
        ],
        [
          2,
          3,
          5
        ]
      ],
      "expected": [
        true,
        false,
        true
      ]
    },
    {
      "name": "递增数组任意连续段等差",
      "args": [
        [
          1,
          2,
          3,
          4
        ],
        [
          0,
          1
        ],
        [
          3,
          3
        ]
      ],
      "expected": [
        true,
        true
      ]
    },
    {
      "name": "重复数也可组成公差零数列",
      "args": [
        [
          5,
          5,
          5
        ],
        [
          0
        ],
        [
          2
        ]
      ],
      "expected": [
        true
      ]
    }
  ]
}
