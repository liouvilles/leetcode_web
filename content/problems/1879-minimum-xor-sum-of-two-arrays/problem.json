  "solutions": [
    {
      "id": "bitmask-assignment-dp",
      "title": "状态压缩匹配 DP",
      "kind": "最优",
      "idea": "对每个已用下标集合求完成剩余匹配的最小代价。",
      "steps": [
        "memo[mask]，index=bitCount(mask)",
        "若 mask 全满返回零",
        "枚举未使用 j，取 nums1[index]^nums2[j]+dfs(mask|1<<j) 最小值"
      ],
      "complexity": {
        "time": "O(n·2^n)",
        "space": "O(2^n)"
      },
