    {
      "id": "kadane",
      "title": "Kadane 状态压缩",
      "kind": "最优",
      "idea": "当前状态只依赖前一个状态，因此用一个变量代替整个 dp 数组。",
      "steps": [
        "current 保存以上一位置结尾的最优和",
        "决定接续还是从当前元素重启",
        "同步维护 best"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
