  "slug": "find-the-middle-index-in-array",
  "title": "找到数组的中间位置",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-029",
  "studyTags": [
    "数组",
    "前缀和"
  ],
  "summary": "找最左下标，使其左侧元素和等于右侧元素和，不存在返回负一。",
  "insight": "先求总和，扫描时维护左侧和；右侧和等于 total-left-nums[i]，相等即是最左答案。",
  "pitfalls": [
    "左右空区间和为零",
    "返回最左位置",
    "当前元素不计入任一侧"
  ],
  "solutions": [
    {
      "id": "running-left-total",
      "title": "总和与滚动左和",
      "kind": "最优",
      "idea": "一次扫描由总和计算右侧和。",
      "steps": [
        "total=数组和、left=0",
        "遍历 i，若 left==total-left-nums[i] 返回 i",
        "left+=nums[i]；结束返回 -1"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/running-left-total/Solution.java",
        "kotlin": "solutions/running-left-total/Solution.kt",
        "cpp": "solutions/running-left-total/solution.cpp"
      }
    }
  ]
}
