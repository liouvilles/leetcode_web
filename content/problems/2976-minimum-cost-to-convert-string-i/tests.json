{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minimumCost",
  "parameterTypes": [
    "string",
    "string",
    "charArray",
    "charArray",
    "intArray"
  ],
  "returnType": "long",
  "cases": [
    {
      "name": "四个位置使用直接与间接转换共花二十八",
      "args": [
        "abcd",
        "acbe",
        [
          "a",
          "b",
          "c",
          "c",
          "e",
          "d"
        ],
        [
          "b",
          "c",
          "b",
          "e",
          "b",
          "e"
        ],
        [
          2,
          5,
          5,
          1,
          2,
          20
        ]
      ],
      "expected": 28
    },
    {
      "name": "每个 a 经过 c 转为 b 共花十二",
      "args": [
        "aaaa",
        "bbbb",
        [
          "a",
          "c"
        ],
        [
          "c",
          "b"
        ],
        [
          1,
          2
        ]
      ],
      "expected": 12
    },
    {
      "name": "缺少 d 到 e 的路径时无法完成转换",
      "args": [
        "abcd",
        "abce",
        [
          "a"
        ],
        [
          "e"
        ],
        [
          10000
        ]
      ],
      "expected": -1
    },
    {
      "name": "重复直接边与多步路径中选择总成本十一",
      "args": [
        "abc",
        "ddd",
        [
          "a",
          "a",
          "a",
          "b",
          "c",
          "e"
        ],
        [
          "d",
          "d",
          "b",
          "d",
          "e",
          "d"
        ],
        [
          100,
          50,
          1,
          3,
          2,
          2
        ]
      ],
      "expected": 11
    },
    {
      "name": "相同字符串即使规则无关也无需成本",
      "args": [
        "xyz",
        "xyz",
        [
          "a"
        ],
        [
          "b"
        ],
        [
          5
        ]
      ],
      "expected": 0
    },
    {
      "name": "三千次百万成本转换验证长整数累计",
      "args": [
        "",
        "",
        [
          "a"
        ],
        [
          "b"
        ],
        [
          1000000
        ]
      ],
      "expected": 3000000000
    }
  ]
}
