{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maxNonDecreasingLength",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "三个位置最多形成长度二",
      "args": [
        [
          2,
          3,
          1
        ],
        [
          1,
          2,
          1
        ]
      ],
      "expected": 2
    },
    {
      "name": "从两数组交替选择形成长度四",
      "args": [
        [
          1,
          3,
          2,
          1
        ],
        [
          2,
          2,
          3,
          4
        ]
      ],
      "expected": 4
    },
    {
      "name": "相等元素允许形成完整长度",
      "args": [
        [
          1,
          1
        ],
        [
          2,
          2
        ]
      ],
      "expected": 2
    }
  ]
}
