  "summary": "画一条竖线穿过砖墙，使穿过砖块数量最少；沿内部砖缝不算穿过砖块。",
  "insight": "统计每行所有非最右边砖缝的横坐标，选择出现次数最多的坐标，未命中该缝的行就是穿过砖块数。",
  "pitfalls": [
    "不能沿墙最左或最右边界画线",
    "每行最后一个前缀和不能统计",
    "单砖行没有内部砖缝"
  ],
  "solutions": [
    {
      "id": "edge-frequency",
      "title": "内部砖缝位置计数",
      "kind": "最优",
      "idea": "用前缀宽度作为砖缝坐标并统计跨行频次。",
      "steps": [
        "遍历每行累计除最后一砖外的宽度",
        "counts[position]++ 并维护 maximum",
        "返回 wall.size-maximum"
      ],
      "complexity": {
        "time": "O(total bricks)",
        "space": "O(total edges)"
      },
      "files": {
        "java": "solutions/edge-frequency/Solution.java",
        "kotlin": "solutions/edge-frequency/Solution.kt",
        "cpp": "solutions/edge-frequency/solution.cpp"
      }
    }
  ]
}
