    "位运算"
  ],
  "summary": "从全零数组开始，可单独把一个元素加一或把全部元素乘二，求得到 nums 的最少操作。",
  "insight": "逆向看每个一位都需一次单元素加一，因此加法次数是所有 popcount 之和；全局乘二次数由最大值最高位位置决定。",
  "pitfalls": [
    "零不贡献任何操作",
    "所有元素共享同一批乘二操作",
    "最高位长度减一是乘二次数"
  ],
  "solutions": [
    {
      "id": "bit-count-and-maximum-depth",
      "title": "置位数与最高位深度",
      "kind": "最优",
      "idea": "按二进制构造统计局部加一与全局翻倍。",
      "steps": [
        "increments=ΣbitCount(value)",
        "maximum=max(nums)",
        "doublings=maximum==0?0:bitLength(maximum)-1，循环右移计数",
        "返回 increments+doublings"
      ],
      "complexity": {
        "time": "O(n log V)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/bit-count-and-maximum-depth/Solution.java",
        "kotlin": "solutions/bit-count-and-maximum-depth/Solution.kt",
        "cpp": "solutions/bit-count-and-maximum-depth/solution.cpp"
      }
    }
  ]
