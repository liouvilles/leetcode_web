  "summary": "两人轮流拿走非零完全平方数颗石子，无法操作者输，判断先手在最优策略下能否获胜。",
  "insight": "dp[stones] 表示当前玩家面对该数量能否获胜；只要存在平方数 square 使 dp[stones-square] 为输态，当前就是赢态。",
  "pitfalls": [
    "每次至少拿一颗",
    "零石子是输态",
    "双方都采用最优策略"
  ],
  "solutions": [
    {
      "id": "win-lose-square-dp",
      "title": "胜负状态平方转移",
      "kind": "最优",
      "idea": "从小到大判断是否能一步走到任一输态。",
      "steps": [
        "dp[0]=false",
        "stones 从一到 n，枚举 root²<=stones",
        "若 !dp[stones-root²] 则 dp[stones]=true 并停止；返回 dp[n]"
      ],
      "complexity": {
        "time": "O(n sqrt n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/win-lose-square-dp/Solution.java",
        "kotlin": "solutions/win-lose-square-dp/Solution.kt",
        "cpp": "solutions/win-lose-square-dp/solution.cpp"
      }
    }
  ]
}
