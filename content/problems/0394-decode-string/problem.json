  "solutions": [
    {
      "id": "two-stacks",
      "title": "次数栈 + 字符串栈",
      "kind": "最优",
      "idea": "扫描字符并在括号边界切换当前构造层。",
      "steps": [
        "数字连续累积为 repeat",
        "左括号时压入外层状态并清空当前层",
        "右括号时弹出状态并重复拼接当前层"
      ],
      "complexity": {
        "time": "O(output length)",
        "space": "O(n)"
