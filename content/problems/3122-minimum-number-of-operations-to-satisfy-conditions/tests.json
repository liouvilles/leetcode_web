{
  "schemaVersion": 1,
  "mode": "function",
  "method": "minimumOperations",
  "parameterTypes": [
    "intMatrix"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "各列已统一且相邻列不同无需操作",
      "args": [
        [
          [
            1,
            0,
            2
          ],
          [
            1,
            0,
            2
          ]
        ]
      ],
      "expected": 0
    },
    {
      "name": "三列全相同时交替统一需要三次修改",
      "args": [
        [
          [
            1,
            1,
            1
          ],
          [
            0,
            0,
            0
          ]
        ]
      ],
      "expected": 3
    },
    {
      "name": "单列三个不同数字最少修改两个",
      "args": [
        [
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ]
      ],
      "expected": 2
    },
    {
      "name": "两个相同常数列需把其中一列全部修改",
      "args": [
        [
          [
            5,
            5
          ],
          [
            5,
            5
          ]
        ]
      ],
      "expected": 2
    },
    {
      "name": "零一零三列已经满足条件",
      "args": [
        [
          [
            0,
            1,
            0
          ],
          [
            0,
            1,
            0
          ]
        ]
      ],
      "expected": 0
    },
    {
      "name": "单行相邻重复块各需修改一次",
      "args": [
        [
          [
            1,
            1,
            2,
            2
          ]
        ]
      ],
      "expected": 2
    }
  ]
}
