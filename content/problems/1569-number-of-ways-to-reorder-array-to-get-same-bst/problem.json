  "solutions": [
    {
      "id": "bst-split-combination-dp",
      "title": "BST 分割组合递归",
      "kind": "最优",
      "idea": "递归计算左右插入序列并组合交错位置。",
      "steps": [
        "预计算 combination[n][k] 模 MOD",
        "ways(list)：长度<=2 返回一；按 root 分成 left、right",
        "返回 C(size-1,left.size)*ways(left)*ways(right)%MOD；根调用结果减一"
      ],
      "complexity": {
        "time": "O(n²)",
        "space": "O(n²)"
      },
