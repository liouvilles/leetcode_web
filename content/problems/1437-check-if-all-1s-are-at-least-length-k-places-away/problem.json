  "batch": "batch-020",
  "studyTags": [
    "数组"
  ],
  "summary": "判断二进制数组中任意相邻两个一之间是否至少有 k 个零。",
  "insight": "记录上一个一的下标；当前一与上一个一下标差必须大于 k。",
  "pitfalls": [
    "下标差为 k+1 才表示中间有 k 个位置",
    "零个或一个一总是合法",
    "只需检查相邻的一"
  ],
  "solutions": [
    {
      "id": "previous-one-index",
      "title": "上一个一的位置",
      "kind": "最优",
      "idea": "单遍比较连续出现的一的距离。",
      "steps": [
        "previous 初始化为足够小的负数",
        "扫描 i，遇 nums[i]==1 时检查 i-previous<=k 是否违规",
        "更新 previous=i；扫描结束返回 true"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
