  "studyTags": [
    "数组",
    "滑动窗口",
    "前缀最优"
  ],
  "summary": "奖品位于数轴给定坐标，可选择两个长度为 k 的闭区间，求二者覆盖的不同奖品总数最大值。",
  "insight": "按右端点滑动得到当前长度 k 窗口 [left,right]，用 best[left] 表示 left 之前单个线段最多能覆盖的奖品数，二者相加得到不重叠组合。允许重叠不会优于把重复覆盖部分交给某个线段的等价不重叠方案。",
  "pitfalls": [
    "同一坐标可有多个奖品",
    "两个线段覆盖同一奖品只计一次",
    "窗口条件是坐标差不超过 k",
    "best 使用位置下标前缀而非坐标前缀"
  ],
  "solutions": [
    {
      "id": "sliding-window-with-prefix-best",
      "title": "滑窗加前缀最优单段",
      "kind": "最优",
      "idea": "枚举第二段右端并拼接其左侧最佳第一段。",
      "steps": [
        "left=0、best[n+1]=0、answer=0",
        "right 从0扫描，while positions[right]-positions[left]>k 时 left++",
        "current=right-left+1",
        "answer=max(answer,current+best[left])",
        "best[right+1]=max(best[right],current)",
        "返回 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/sliding-window-with-prefix-best/Solution.java",
        "kotlin": "solutions/sliding-window-with-prefix-best/Solution.kt",
        "cpp": "solutions/sliding-window-with-prefix-best/solution.cpp"
      }
    }
  ]
