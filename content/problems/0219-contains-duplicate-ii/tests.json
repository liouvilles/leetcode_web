{
  "schemaVersion": 1,
  "mode": "function",
  "method": "containsNearbyDuplicate",
  "parameterTypes": [
    "intArray",
    "int"
  ],
  "returnType": "boolean",
  "cases": [
    {
      "name": "距离恰好为三",
      "args": [
        [
          1,
          2,
          3,
          1
        ],
        3
      ],
      "expected": true
    },
    {
      "name": "相邻重复",
      "args": [
        [
          1,
          0,
          1,
          1
        ],
        1
      ],
      "expected": true
    },
    {
      "name": "重复距离过远",
      "args": [
        [
          1,
          2,
          3,
          1,
          2,
          3
        ],
        2
      ],
      "expected": false
    }
  ]
}
