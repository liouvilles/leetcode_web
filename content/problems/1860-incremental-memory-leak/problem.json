{
  "schemaVersion": 1,
  "id": 1860,
  "slug": "incremental-memory-leak",
  "title": "增长的内存泄露",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-027",
  "studyTags": [
    "模拟"
  ],
  "summary": "每秒程序占用当前秒数内存，优先从剩余更多的内存条分配，平局选第一条；首次无法分配时返回时间和两条剩余内存。",
  "insight": "从 time=1 模拟，每次选择较大剩余值并扣 time；若较大值也小于 time 就停止。",
  "pitfalls": [
    "平局选择 memory1",
    "返回的是无法分配的当前秒",
    "每秒需求递增一"
  ],
  "solutions": [
    {
      "id": "second-by-second-greedy",
      "title": "逐秒较大内存优先",
      "kind": "最优",
      "idea": "题目策略确定，直接模拟直到失败。",
      "steps": [
        "time=1",
        "while max(memory1,memory2)>=time，按 memory1>=memory2 选择并扣 time，time++",
        "返回 [time,memory1,memory2]"
      ],
      "complexity": {
        "time": "O(sqrt(total memory))",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/second-by-second-greedy/Solution.java",
        "kotlin": "solutions/second-by-second-greedy/Solution.kt",
        "cpp": "solutions/second-by-second-greedy/solution.cpp"
      }
    }
  ]
}
