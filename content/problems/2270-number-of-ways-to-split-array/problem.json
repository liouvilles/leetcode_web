    {
      "id": "rolling-prefix-comparison",
      "title": "滚动前缀和比较",
      "kind": "最优",
      "idea": "逐合法边界比较两侧总和。",
      "steps": [
        "total=sum(nums)，prefix=0",
        "i 从零到 n-2：prefix+=nums[i]",
        "若 prefix>=total-prefix，answer++；返回 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
