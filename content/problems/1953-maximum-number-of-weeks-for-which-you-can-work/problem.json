      "id": "dominant-project-balance",
      "title": "最大项目与其余平衡",
      "kind": "最优",
      "idea": "由能否交错最大类别决定答案。",
      "steps": [
        "sum 与 maximum",
        "rest=sum-maximum",
        "返回 maximum<=rest+1 ? sum : 2*rest+1"
      ],
