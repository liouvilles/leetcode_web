        ],
        [
          "wood",
          "joke",
          "moat"
        ]
      ],
      "expected": [
        "word",
        "note",
        "wood"
      ]
    },
    {
      "name": "两个查询均符合",
      "args": [
        [
          "yes"
        ],
        [
          "not"
        ]
      ],
      "expected": []
    },
    {
      "name": "完全相同查询直接保留",
      "args": [
        [
          "abc"
        ],
        [
          "abc"
        ]
      ],
      "expected": [
        "abc"
      ]
    }
  ]
