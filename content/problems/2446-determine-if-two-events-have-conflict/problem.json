    {
      "id": "lexicographic-closed-interval-overlap",
      "title": "字典序闭区间相交",
      "kind": "最优",
      "idea": "比较两个开始最大值与结束最小值。",
      "steps": [
        "start=max(event1[0],event2[0])",
        "end=min(event1[1],event2[1])",
        "返回 start<=end"
      ],
      "complexity": {
        "time": "O(1)",
        "space": "O(1)"
