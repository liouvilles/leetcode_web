      "args": [
        [
          "d1/",
          "d2/",
          "./",
          "d3/",
          "../",
          "d31/"
        ]
      ],
      "expected": 3
    },
    {
      "name": "主目录继续向上仍为零",
      "args": [
        [
          "d1/",
          "../",
          "../",
          "../"
        ]
      ],
      "expected": 0
    }
  ]
