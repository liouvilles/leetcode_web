  "solutions": [
    {
      "id": "fixed-window-long-sum",
      "title": "固定窗口长整型和",
      "kind": "最优",
      "idea": "滑动长度 2k+1 的窗口并写入其中心。",
      "steps": [
        "answer 填 -1，window=2k+1；window>n 直接返回",
        "求前 window 项 long sum",
        "center 从 k 到 n-k-1：写 sum/window；若还有下个窗口则加右新项减左旧项"
      ],
      "complexity": {
        "time": "O(n)",
