    {
      "id": "cycle-modulo-scan",
      "title": "整轮取模后扫描",
      "kind": "最优",
      "idea": "消去完整循环并定位余数首次不足的位置。",
      "steps": [
        "sum=Σchalk",
        "remaining=k%sum",
        "从下标零：若 remaining<chalk[i] 返回 i，否则扣除；继续"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
