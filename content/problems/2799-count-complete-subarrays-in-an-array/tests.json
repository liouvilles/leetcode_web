        ]
      ],
      "expected": 4
    },
    {
      "name": "全相同数组所有子数组完整",
      "args": [
        [
          5,
          5,
          5
        ]
      ],
      "expected": 6
    },
    {
      "name": "全不同数组只有整体完整",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": 1
    }
  ]
