    {
      "id": "prefix-span-translation-count",
      "title": "前缀跨度平移计数",
      "kind": "最优",
      "idea": "所有隐藏数组只差一个整体平移量。",
      "steps": [
        "prefix=0，minimum=maximum=0",
        "累加 differences 并更新前缀极值",
        "answer=(upper-lower)-(maximum-minimum)+1；小于零则返回零"
      ],
