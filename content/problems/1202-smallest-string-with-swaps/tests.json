{
  "schemaVersion": 1,
  "mode": "function",
  "method": "smallestStringWithSwaps",
  "parameterTypes": [
    "string",
    "intListMatrix"
  ],
  "returnType": "string",
  "cases": [
    {
      "name": "两个独立交换对",
      "args": [
        "dcab",
        [
          [
            0,
            3
          ],
          [
            1,
            2
          ]
        ]
      ],
      "expected": "bacd"
    },
    {
      "name": "连通后全局重排",
      "args": [
        "dcab",
        [
          [
            0,
            3
          ],
          [
            1,
            2
          ],
          [
            0,
            2
          ]
        ]
      ],
      "expected": "abcd"
    },
    {
      "name": "重复字符分量",
      "args": [
        "cba",
        [
          [
            0,
            1
          ],
          [
            1,
            2
          ]
        ]
      ],
      "expected": "abc"
    }
  ]
}
