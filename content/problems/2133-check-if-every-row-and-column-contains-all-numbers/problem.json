  "solutions": [
    {
      "id": "row-column-seen-check",
      "title": "行列去重检查",
      "kind": "最优",
      "idea": "分别为每行和每列建立布尔出现表。",
      "steps": [
        "对每个 index 初始化 rowSeen、columnSeen",
        "扫描 j，检查 grid[index][j] 与 grid[j][index] 是否在一到 n 且未出现",
        "任一非法返回 false；全部完成返回 true"
      ],
