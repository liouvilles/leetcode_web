      "kind": "最优",
      "idea": "先累计每个值总收益，再滚动决定取或不取。",
      "steps": [
        "建立 points[value]+=value",
        "take、skip 初始化零，按 value 升序扫描",
        "newTake=skip+points[value]，newSkip=max(skip,take)，滚动后返回 max"
      ],
