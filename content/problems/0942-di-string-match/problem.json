    "双指针"
  ],
  "summary": "给定由 I 和 D 组成的长度 n 字符串，构造 0 到 n 的排列，使相邻大小关系分别满足递增或递减。",
  "insight": "维护当前未使用的最小值和最大值；I 放最小值确保后面总能更大，D 放最大值确保后面总能更小，最后两端汇合。",
  "pitfalls": [
    "答案长度比字符串多一",
    "每步消费 low 或 high 一个端点",
    "最终剩余值 low==high"
  ],
  "solutions": [
    {
      "id": "low-high-greedy",
      "title": "最小最大双端贪心",
      "kind": "最优",
      "idea": "按关系字符从可用区间端点取值。",
      "steps": [
        "low=0,high=n",
        "遍历 s；I 写 low 后 low++，D 写 high 后 high--",
        "末位写 low，返回排列"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/low-high-greedy/Solution.java",
        "kotlin": "solutions/low-high-greedy/Solution.kt",
        "cpp": "solutions/low-high-greedy/solution.cpp"
      }
    }
  ]
}
