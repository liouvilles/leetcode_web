  "slug": "check-if-array-is-sorted-and-rotated",
  "title": "检查数组是否经排序和轮转得到",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-025",
  "studyTags": [
    "数组"
  ],
  "summary": "判断数组是否能由一个非降序数组轮转若干位置得到，数组可含重复值。",
  "insight": "沿环比较相邻元素，非降序轮转数组最多只有一个严格下降断点；把末尾到开头也纳入比较。",
  "pitfalls": [
    "相等不算下降",
    "需要检查 nums[n-1] 到 nums[0]",
    "零次轮转也合法"
  ],
  "solutions": [
    {
      "id": "circular-drop-count",
      "title": "环形下降点计数",
      "kind": "最优",
      "idea": "用唯一可能的轮转接缝刻画合法数组。",
      "steps": [
        "drops=0",
        "i 从零到 n-1，比较 nums[i] 与 nums[(i+1)%n]",
        "前者大于后者则 drops++，返回 drops<=1"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/circular-drop-count/Solution.java",
        "kotlin": "solutions/circular-drop-count/Solution.kt",
        "cpp": "solutions/circular-drop-count/solution.cpp"
      }
    }
  ]
}
