  "solutions": [
    {
      "id": "count-signs",
      "title": "分别计数正负数",
      "kind": "最优",
      "idea": "线性扫描完成。",
      "steps": [
        "negative=positive=0",
        "value<0 时 negative++，value>0 时 positive++",
        "返回 max(negative,positive)"
      ],
