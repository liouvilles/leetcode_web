  "summary": "把二进制数组完整划分为若干非空子数组，使每段恰好含一个一，统计划分方式并取模。",
  "insight": "相邻两个一之间若距离为 d，分割线可以放在它们之间的 d 个缝隙之一；不同间隔选择独立，因此把所有相邻一的下标差相乘。首个一前和末个一后的零没有额外选择。",
  "pitfalls": [
    "没有一时无法形成好子数组",
    "每段必须恰好一个一",
    "答案对十亿零七取模",
    "相邻一的距离而非中间零数量是选择数"
  ],
  "solutions": [
    {
      "id": "multiply-distances-between-ones",
      "title": "累乘相邻一的距离",
      "kind": "最优",
      "idea": "每个相邻一间隔独立选择一条分割线。",
      "steps": [
        "previousOne=-1、answer=1",
        "扫描所有下标 i",
        "遇到一且已有前一个一时乘以 i-previousOne",
        "更新 previousOne=i",
        "扫描后若未见一返回零，否则返回 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/multiply-distances-between-ones/Solution.java",
        "kotlin": "solutions/multiply-distances-between-ones/Solution.kt",
        "cpp": "solutions/multiply-distances-between-ones/solution.cpp"
      }
    }
  ]
}
