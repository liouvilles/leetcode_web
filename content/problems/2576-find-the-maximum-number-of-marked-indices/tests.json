{
  "schemaVersion": 1,
  "mode": "function",
  "method": "maxNumOfMarkedIndices",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "四个数只能形成一对",
      "args": [
        [
          3,
          5,
          2,
          4
        ]
      ],
      "expected": 2
    },
    {
      "name": "排序后可形成两对",
      "args": [
        [
          9,
          2,
          5,
          4
        ]
      ],
      "expected": 4
    },
    {
      "name": "三个接近的数无法配对",
      "args": [
        [
          7,
          6,
          8
        ]
      ],
      "expected": 0
    }
  ]
}
