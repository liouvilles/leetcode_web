{
  "schemaVersion": 1,
  "mode": "function",
  "method": "incremovableSubarrayCount",
  "parameterTypes": [
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "严格递增数组的所有十个子数组都可删除",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 10
    },
    {
      "name": "删除开头或中间可连接递增前后缀",
      "args": [
        [
          6,
          5,
          7,
          8
        ]
      ],
      "expected": 7
    },
    {
      "name": "尾部相等阻止后缀继续扩展",
      "args": [
        [
          8,
          7,
          6,
          6
        ]
      ],
      "expected": 3
    },
    {
      "name": "单元素只能删除整个数组",
      "args": [
        [
          5
        ]
      ],
      "expected": 1
    },
    {
      "name": "两个相等元素的三个非空删除段都合法",
      "args": [
        [
          1,
          1
        ]
      ],
      "expected": 3
    }
  ]
}
