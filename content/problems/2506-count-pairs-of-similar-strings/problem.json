  "solutions": [
    {
      "id": "letter-mask-frequency",
      "title": "字母集合位掩码计数",
      "kind": "最优",
      "idea": "把集合相等转化为整数键相等。",
      "steps": [
        "对 word 初始化 mask=0",
        "每个字符设置 mask 的对应位",
        "answer += frequency[mask]",
        "frequency[mask]++，最终返回 answer"
      ],
      "complexity": {
        "time": "O(total characters)",
        "space": "O(number of masks)"
      },
