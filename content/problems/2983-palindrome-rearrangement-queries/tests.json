{
  "schemaVersion": 1,
  "mode": "function",
  "method": "canMakePalindromeQueries",
  "parameterTypes": [
    "string",
    "intMatrix"
  ],
  "returnType": "booleanArray",
  "cases": [
    {
      "name": "官方两组查询分别重排右半与左半即可成回文",
      "args": [
        "abcabc",
        [
          [
            1,
            1,
            3,
            5
          ],
          [
            0,
            2,
            5,
            5
          ]
        ]
      ],
      "expected": [
        true,
        true
      ]
    },
    {
      "name": "可重排区间并集外仍有失配",
      "args": [
        "abbcdecbba",
        [
          [
            0,
            2,
            7,
            9
          ]
        ]
      ],
      "expected": [
        false
      ]
    },
    {
      "name": "两个映射区间部分相交且剩余字符相同",
      "args": [
        "acbcab",
        [
          [
            1,
            2,
            4,
            5
          ]
        ]
      ],
      "expected": [
        true
      ]
    },
    {
      "name": "映射区间相离时分别检查固定对侧需求",
      "args": [
        "abcdefefdcab",
        [
          [
            0,
            1,
            6,
            7
          ],
          [
            0,
            0,
            6,
            7
          ]
        ]
      ],
      "expected": [
        true,
        false
      ]
    },
    {
      "name": "部分相交区间扣除两侧固定字符后交集可配对",
      "args": [
        "abcdedecab",
        [
          [
            0,
            2,
            5,
            7
          ]
        ]
      ],
      "expected": [
        true
      ]
    },
    {
      "name": "两个映射区间完全相同且内部字符多重集一致",
      "args": [
        "abcdeebcda",
        [
          [
            1,
            3,
            6,
            8
          ]
        ]
      ],
      "expected": [
        true
      ]
    }
  ]
}
