  "solutions": [
    {
      "id": "sorted-copy-position-compare",
      "title": "排序副本逐位比较",
      "kind": "最优",
      "idea": "显式构造期望序列并统计差异。",
      "steps": [
        "expected=heights.clone 并升序排序",
        "mismatches=0",
        "对所有 i，若 heights[i]!=expected[i] 则 mismatches++，返回"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(n)"
