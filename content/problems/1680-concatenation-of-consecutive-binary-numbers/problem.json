  "summary": "按顺序连接 1 到 n 的二进制表示，把所得二进制串视为整数并对 1e9+7 取模。",
  "insight": "追加 i 的二进制等价于把当前答案左移 bitLength(i) 位再加 i。i 为二的幂时位数增加一。",
  "pitfalls": [
    "二进制表示没有前导零",
    "每一步都需取模避免溢出",
    "判断二的幂可用 i&(i-1)==0"
  ],
  "solutions": [
    {
      "id": "rolling-binary-concatenation",
      "title": "滚动二进制拼接",
      "kind": "最优",
      "idea": "用移位数值公式避免构造巨大字符串。",
      "steps": [
        "answer=0，bits=0",
        "i 从一到 n，若 i 是二的幂则 bits++",
        "answer=((answer<<bits)+i)%MOD，返回 answer"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/rolling-binary-concatenation/Solution.java",
        "kotlin": "solutions/rolling-binary-concatenation/Solution.kt",
        "cpp": "solutions/rolling-binary-concatenation/solution.cpp"
      }
    }
  ]
}
