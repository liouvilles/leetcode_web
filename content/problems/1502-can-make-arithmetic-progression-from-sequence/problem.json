  "studyTags": [
    "数组",
    "排序"
  ],
  "summary": "判断数组重排后能否使相邻元素差值全部相同。",
  "insight": "升序排序后等差数列顺序唯一，只需比较每个相邻差与首个差。",
  "pitfalls": [
    "差值可为零或负数但排序后非负",
    "数组至少两个元素",
    "重复元素全部相同时也合法"
  ],
  "solutions": [
    {
      "id": "sorted-difference-check",
      "title": "排序后差值检查",
      "kind": "最优",
      "idea": "把重排问题规范为升序相邻比较。",
      "steps": [
        "排序 arr",
        "difference=arr[1]-arr[0]",
        "i 从二开始，若 arr[i]-arr[i-1]!=difference 返回 false，否则最终 true"
      ],
      "complexity": {
        "time": "O(n log n)",
        "space": "O(log n)"
      },
      "files": {
        "java": "solutions/sorted-difference-check/Solution.java",
        "kotlin": "solutions/sorted-difference-check/Solution.kt",
        "cpp": "solutions/sorted-difference-check/solution.cpp"
      }
    }
  ]
