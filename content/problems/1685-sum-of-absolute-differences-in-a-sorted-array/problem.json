    "前缀和"
  ],
  "summary": "升序数组中，对每个位置求它与所有元素差的绝对值之和。",
  "insight": "排序保证左侧都不大于当前值、右侧都不小于当前值。用前缀和分别计算左贡献 value*i-leftSum 与右贡献 rightSum-value*count。",
  "pitfalls": [
    "当前元素不应重复计入任一侧贡献",
    "总和可能需要中间使用 long",
    "输入已排序无需再次排序"
  ],
  "solutions": [
    {
      "id": "prefix-sum-contributions",
      "title": "前缀和分侧贡献",
      "kind": "最优",
      "idea": "利用有序性去掉绝对值符号。",
      "steps": [
        "求 totalSum，leftSum=0",
        "对 i：left=value*i-leftSum，right=(total-leftSum-value)-value*(n-i-1)",
        "answer[i]=left+right，再把 value 加入 leftSum"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(n)"
      },
      "files": {
        "java": "solutions/prefix-sum-contributions/Solution.java",
        "kotlin": "solutions/prefix-sum-contributions/Solution.kt",
        "cpp": "solutions/prefix-sum-contributions/solution.cpp"
      }
    }
  ]
}
