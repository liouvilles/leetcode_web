  "title": "转换字符串的最少操作次数",
  "status": "published",
  "qualityGate": "tested",
  "batch": "batch-029",
  "studyTags": [
    "字符串",
    "贪心"
  ],
  "summary": "每次选择连续三个字符全改为 O，求把含 X 和 O 的字符串变为全 O 的最少操作次数。",
  "insight": "从左到右遇到最早未处理 X 时必须有一次操作覆盖它；把操作起点放在该位置能覆盖最靠右的三个字符，因此计数并跳过三格最优。",
  "pitfalls": [
    "末尾操作仍可覆盖不足三的剩余字符串范围",
    "已经是 O 的位置无需操作",
    "每次操作会把三格全部变 O"
  ],
  "solutions": [
    {
      "id": "leftmost-x-greedy",
      "title": "最左 X 贪心覆盖",
      "kind": "最优",
      "idea": "每次从最左未覆盖 X 开始一次操作。",
      "steps": [
        "index=answer=0",
        "若 s[index]==X，answer++ 且 index+=3",
        "否则 index++；返回"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "files": {
        "java": "solutions/leftmost-x-greedy/Solution.java",
        "kotlin": "solutions/leftmost-x-greedy/Solution.kt",
        "cpp": "solutions/leftmost-x-greedy/solution.cpp"
      }
    }
  ]
