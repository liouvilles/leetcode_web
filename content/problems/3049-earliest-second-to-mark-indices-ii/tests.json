{
  "schemaVersion": 1,
  "mode": "function",
  "method": "earliestSecondToMarkIndices",
  "parameterTypes": [
    "intArray",
    "intArray"
  ],
  "returnType": "int",
  "cases": [
    {
      "name": "三次快速置零后再标记可在第六秒完成",
      "args": [
        [
          3,
          2,
          3
        ],
        [
          1,
          3,
          2,
          2,
          2,
          2,
          3
        ]
      ],
      "expected": 6
    },
    {
      "name": "未出现在序列中的下标仍可普通减一并标记",
      "args": [
        [
          0,
          0,
          1,
          2
        ],
        [
          1,
          2,
          1,
          2,
          1,
          2,
          1,
          2
        ]
      ],
      "expected": 7
    },
    {
      "name": "三秒不足以处理三个正数下标",
      "args": [
        [
          1,
          2,
          3
        ],
        [
          1,
          2,
          3
        ]
      ],
      "expected": -1
    },
    {
      "name": "单个大数用一次快速置零和一次标记",
      "args": [
        [
          1000000000
        ],
        [
          1,
          1
        ]
      ],
      "expected": 2
    },
    {
      "name": "空闲不足时以较早高收益方案替换较晚低收益方案",
      "args": [
        [
          0,
          2,
          3
        ],
        [
          1,
          1,
          1,
          3,
          2,
          1
        ]
      ],
      "expected": 6
    }
  ]
}
